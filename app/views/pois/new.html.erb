<%# Pois New - форма создания POI (отдельная страница для fallback) %>
<div class="max-w-2xl mx-auto py-8 px-4">
  <div class="mb-6">
    <%= link_to pois_path, class: "inline-flex items-center text-gray-600 hover:text-gray-900" do %>
      <i class="mdi mdi-arrow-left mr-2"></i>
      <%# Иконка: mdi-arrow-left %>
      <%= t("common.back") %>
    <% end %>
  </div>

  <%= render Poi::AddFormComponent.new(categories: @categories, poi: @poi) %>
</div>
