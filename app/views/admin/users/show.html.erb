<%# frozen_string_literal: true %>

<%#
# app/views/admin/users/show.html.erb - детальная страница пользователя
#
# Отображает:
# - Хлебные крошки
# - Профиль пользователя (ShowComponent) или форму редактирования (EditComponent)
# - Табы: Activity, Wallet, Audit Log (через Ui::TabsComponent)
# %>

<div class="max-w-4xl mx-auto">
  <%# Хлебные крошки %>
  <%= render Ui::BreadcrumbsComponent.new(breadcrumbs: [
    { name: t("admin.users.index.title"), path: admin_users_path(q: params[:q], status: params[:status]) },
    { name: @user.name }
  ]) %>

  <%# Профиль или форма редактирования %>
  <div id="user-profile">
    <% if @edit_mode %>
      <%= render Admin::Users::User::EditComponent.new(user: @user, roles: @roles) %>
    <% else %>
      <%= render Admin::Users::User::ShowComponent.new(user: @user) %>
    <% end %>
  </div>

  <%# Табы: Activity, Wallet, Audit Log %>
  <% active_tab = params[:audit_page].present? ? "audit_log" : "activity" %>
  <%= render Ui::TabsComponent.new(
        tabs: [
          { id: "activity",  name: t("admin.users.tabs.activity"),  icon: "mdi-history" },
          { id: "wallet",    name: t("admin.users.tabs.wallet"),    icon: "mdi-wallet" },
          { id: "audit_log", name: t("admin.users.tabs.audit_log"), icon: "mdi-clipboard-text-search" }
        ],
        active_tab: active_tab,
        panels: {
          activity:  render(Admin::Users::User::ActivityComponent.new(user: @user)),
          wallet:    content_tag(:div, data: { admin_user_wallet: true }) do
                       render(Admin::Users::User::WalletComponent.new(user: @user))
                     end,
          audit_log: content_tag(:div, data: { audit_log: true }) do
            if @versions.any?
              @versions.each { |v| concat render(Ui::AuditEntryComponent.new(version: v)) }
            else
              concat render(Ui::AuditEntryComponent.new(version: nil))
            end
          end
        }
      ) %>
</div>
