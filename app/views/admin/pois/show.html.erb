<%# frozen_string_literal: true %>

<%#
# app/views/admin/pois/show.html.erb - детальная страница POI в админке
#
# Отображает:
# - Хлебные крошки
# - Шапку POI (HeaderComponent) или форму редактирования (EditComponent)
# - Табы: Details, Map, Audit Log (через Ui::TabsComponent)
#
# Селекторы-цели для PoiBroadcaster:
#   #poi-detail — шапка (HeaderComponent → обновляется inner_html)
#   [data-poi-detail-body] — содержимое таба Details (ShowComponent → inner_html)
# %>

<div class="max-w-4xl mx-auto">
  <%# Хлебные крошки %>
  <%= render Ui::BreadcrumbsComponent.new(breadcrumbs: [
    { name: t("admin.pois.index.title"), path: admin_pois_path },
    { name: @poi.localized_name }
  ]) %>

  <%# Шапка POI или форма редактирования %>
  <div id="poi-detail">
    <% if @edit_mode %>
      <%= render Admin::Pois::Poi::EditComponent.new(poi: @poi, categories: @categories) %>
    <% else %>
      <%= render Admin::Pois::Poi::HeaderComponent.new(poi: @poi) %>
    <% end %>
  </div>

  <%# Табы: Details, Map, Audit Log (только в режиме просмотра) %>
  <% unless @edit_mode %>
    <% active_tab = params[:tab].presence || "details" %>
    <%= render Ui::TabsComponent.new(
          tabs: [
            { id: "details",   name: t("admin.pois.tabs.details"),   icon: "mdi-information-outline" },
            { id: "map",       name: t("admin.pois.tabs.map"),       icon: "mdi-map" },
            { id: "audit_log", name: t("admin.pois.tabs.audit_log"), icon: "mdi-clipboard-text-search" }
          ],
          active_tab: active_tab,
          panels: {
            details: content_tag(:div, data: { poi_detail_body: true }) do
              concat render(Admin::Pois::Poi::ShowComponent.new(poi: @poi))
            end,
            map:       render(Poi::MapComponent.new(poi: @poi)),
            audit_log: content_tag(:div, data: { audit_log: true }) do
              if @versions.any?
                @versions.each { |v| concat render(Ui::AuditEntryComponent.new(version: v)) }
              else
                concat render(Ui::AuditEntryComponent.new(version: nil))
              end
            end
          }
        ) %>

    <%# Галерея фото POI (админ). Контейнер-цель [data-poi-gallery-admin] на обёртке
        (НЕ на корне GalleryComponent — догма inner_html без вложенности).
        Зона вынесена ИЗ ShowComponent: галерея контекстно-зависима (сортировка
        «свои вначале» + кнопки удаления у разных зрителей различаются), поэтому
        Обновляется через PoiReflex#refresh_gallery с current_user (inner_html в
        оба селектора [data-poi-gallery] / [data-poi-gallery-admin]), а НЕ через
        PoiBroadcaster (в SolidQueue-воркере current_user=nil → кнопки пропали бы). %>
    <div class="mt-6 pt-6 border-t border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-3"><%= t("admin.pois.poi.show_component.gallery") %></h3>
      <div data-poi-gallery-admin>
        <%= render Poi::GalleryComponent.new(poi: @poi, current_user: current_user) %>
      </div>
    </div>
  <% end %>
</div>
