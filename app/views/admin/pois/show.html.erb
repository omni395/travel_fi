<%# frozen_string_literal: true %>

<%#
# app/views/admin/pois/show.html.erb - детальная страница POI в админке
#
# Отображает:
# - Хлебные крошки
# - Детальную информацию о POI (ShowComponent) или форму редактирования (EditComponent)
# - Табы: Details, Map, Audit Log (через Ui::TabsComponent)
# %>

<div class="max-w-4xl mx-auto">
  <%# Хлебные крошки %>
  <%= render Ui::BreadcrumbsComponent.new(breadcrumbs: [
    { name: t("admin.pois.index.title"), path: admin_pois_path },
    { name: @poi.localized_name }
  ]) %>

  <%# Детальная информация или форма редактирования %>
  <div id="poi-detail">
    <% if @edit_mode %>
      <%= render Admin::Pois::Poi::EditComponent.new(poi: @poi, categories: @categories) %>
    <% else %>
      <%= render Admin::Pois::Poi::ShowComponent.new(poi: @poi) %>
    <% end %>
  </div>

  <%# Табы: Details, Map, Audit Log (только в режиме просмотра) %>
  <% unless @edit_mode %>
    <% active_tab = params[:tab].presence || "details" %>
    <%= render Ui::TabsComponent.new(
          tabs: [
            { id: "details",   name: t("admin.pois.tabs.details"),   icon: "mdi-information-outline" },
            { id: "map",       name: t("admin.pois.tabs.map"),       icon: "mdi-map" },
            { id: "audit_log", name: t("admin.pois.tabs.audit_log"), icon: "mdi-clipboard-text-search" }
          ],
          active_tab: active_tab,
          panels: {
            details:   render(Admin::Pois::Poi::ShowComponent.new(poi: @poi)),
            map:       render(Poi::MapComponent.new(poi: @poi)),
            audit_log: content_tag(:div, data: { audit_log: true }) do
              if @versions.any?
                @versions.each { |v| concat render(Ui::AuditEntryComponent.new(version: v)) }
              else
                concat render(Ui::AuditEntryComponent.new(version: nil))
              end
            end
          }
        ) %>
  <% end %>
</div>
