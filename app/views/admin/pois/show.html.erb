<%# frozen_string_literal: true %>

<%#
# app/views/admin/pois/show.html.erb - детальная страница POI в админке
#
# Отображает:
# - Хлебные крошки
# - Детальную информацию о POI
# - Историю изменений (PaperTrail)
# %>

<div class="p-4">
  <%# Хлебные крошки %>
  <%= render Ui::BreadcrumbsComponent.new(breadcrumbs: [
    { name: t("admin.pois.index.title"), path: admin_pois_path },
    { name: @poi.localized_name }
  ]) %>

  <%# Детальная информация о POI %>
  <%= render Admin::Poi::ShowComponent.new(poi: @poi) %>

  <%# История изменений %>
  <% if @versions.present? %>
    <div class="mt-6 bg-white shadow rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">
        <i class="mdi mdi-history text-gray-500 mr-2"></i>
        <%# Иконка: mdi-history %>
        <%= t("admin.pois.version_history") %>
      </h3>
      <div class="space-y-3">
        <% @versions.each do |version| %>
          <div class="flex items-start gap-3 text-sm">
            <div class="shrink-0 mt-0.5">
              <% if version.event == "create" %>
                <i class="mdi mdi-plus-circle text-green-500"></i>
              <% elsif version.event == "update" %>
                <i class="mdi mdi-pencil text-teal-500"></i>
              <% elsif version.event == "destroy" %>
                <i class="mdi mdi-delete text-red-500"></i>
              <% end %>
            </div>
            <div>
              <span class="font-medium text-gray-900"><%= version.event.humanize %></span>
              <span class="text-gray-500 ml-2">
                <%= version.whodunnit.present? ? User.find_by(id: version.whodunnit)&.name || version.whodunnit : t("admin.pois.system") %>
              </span>
              <span class="text-gray-400 ml-2"><%= l(version.created_at, format: :short) %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
