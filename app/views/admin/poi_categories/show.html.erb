<%# frozen_string_literal: true %>

<%#
# app/views/admin/poi_categories/show.html.erb - детальная страница категории POI
#
# Отображает:
# - Хлебные крошки
# - Детальную информацию о категории (ShowComponent) или форму редактирования (EditComponent)
# - Табы: Fields, POIs, Audit Log (через Ui::TabsComponent)
# %>

<div class="max-w-4xl mx-auto">
  <%# Хлебные крошки %>
  <%= render Ui::BreadcrumbsComponent.new(breadcrumbs: [
    { name: t("admin.poi_categories.index.title"), path: admin_poi_categories_path },
    { name: @category.localized_name }
  ]) %>

  <%# Детальная информация или форма редактирования %>
  <div id="poi-category-detail">
    <% if @edit_mode %>
      <%= render Admin::PoiCategories::PoiCategory::EditComponent.new(category: @category) %>
    <% else %>
      <%= render Admin::PoiCategories::PoiCategory::ShowComponent.new(category: @category) %>
    <% end %>
  </div>

  <%# Табы: Fields, POIs, Audit Log (только в режиме просмотра) %>
  <% unless @edit_mode %>
    <% active_tab = params[:tab].presence || "fields" %>
    <%= render Ui::TabsComponent.new(
          tabs: [
            { id: "fields",    name: t("admin.poi_categories.tabs.fields"),    icon: "mdi-form-textbox" },
            { id: "pois",      name: t("admin.poi_categories.tabs.pois"),      icon: "mdi-map-marker-multiple" },
            { id: "audit_log", name: t("admin.poi_categories.tabs.audit_log"), icon: "mdi-clipboard-text-search" }
          ],
          active_tab: active_tab,
          panels: {
            fields: content_tag(:div, data: { poi_category_fields: true }) do
              concat render(Admin::PoiCategories::PoiCategory::FieldsListComponent.new(
                category: @category,
                add_button: false,
                with_form: false
              ))
            end,
            pois: content_tag(:div, data: { poi_category_pois: true }) do
              concat render(Admin::PoiCategories::PoiCategory::PoisListComponent.new(
                category: @category,
                pagy: @pagy_pois,
                pois: @pois
              ))
            end,
            audit_log: content_tag(:div, data: { audit_log: true }) do
              concat render(Admin::PoiCategories::PoiCategory::AuditLogComponent.new(
                category: @category,
                versions: @versions,
                pagy: @pagy_audit
              ))
            end
          }
        ) %>
  <% end %>
</div>
