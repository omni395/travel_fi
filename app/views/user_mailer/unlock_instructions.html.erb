<h2><%= t("devise.mailer.unlock_instructions.greeting", name: @user.name) %></h2>

<p>
  <%= t("devise.mailer.unlock_instructions.message") %>
</p>

<p>
  <%= link_to t("devise.mailer.unlock_instructions.action"), @unlock_url, style: "display: inline-block; padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px;" %>
</p>

<p>
  <%= t("devise.mailer.unlock_instructions.instruction") %>
  <code><%= @unlock_url %></code>
</p>

<p><%= t("devise.mailer.unlock_instructions.closing") %></p>
