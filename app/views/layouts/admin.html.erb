<!DOCTYPE html>
<html lang="<%= I18n.locale.to_s %>">
  <head>
    <title><%= content_for(:title) || "Admin - Travel Fi" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0288D1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Travel Fi - Admin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="/manifest.json">

    <!-- Material Design Icons (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css">

    <!-- Leaflet CSS (CDN) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />

    <!-- Tailwind CSS -->
    <%= stylesheet_link_tag :app %>
    <%= javascript_include_tag "admin", type: "module" %>
  </head>

<body class="flex flex-col h-screen bg-gray-50 overflow-hidden" data-controller="cable">
  <div data-controller="reveal" data-reveal-hidden-class="-translate-x-full" class="flex flex-col h-full">
    
    <!-- 1. ХЕДЕР: Фиксированная высота 64px -->
    <header class="h-16 bg-white border-b shrink-0 relative z-[70]">
      <%= render NavbarComponent.new(user: current_user) %>
    </header>

    <div class="flex flex-1 overflow-hidden relative">
      
      <!-- 2. МОБИЛЬНЫЙ САЙДБАР: Без изменений -->
      <aside id="admin-sidebar-mobile" 
             data-reveal-target="item" 
             class="fixed top-16 left-0 z-[60] w-64 bg-gradient-primary-to-secondary shadow-2xl transition-transform duration-300 -translate-x-full md:hidden h-[calc(100vh-64px)]">
        <%= render Admin::SidebarComponent.new(current_page: controller_name, user: current_user, is_mobile: true) %>
      </aside>

      <!-- 3. ДЕСКТОПНЫЙ САЙДБАР: FIXED для наложения (Overlay) -->
      <aside class="hidden md:flex flex-col fixed top-16 left-0 z-30 bg-gradient-primary-to-secondary w-16 hover:w-64 group transition-all duration-300 ease-in-out h-[calc(100vh-64px)]">
        <%= render Admin::SidebarComponent.new(current_page: controller_name, user: current_user, is_mobile: false) %>
      </aside>

      <!-- 4. КОНТЕНТ: ml-16 чтобы не подлезал под узкий сайдбар, overflow-y-auto для скролла -->
      <main class="flex-1 overflow-y-auto p-4 md:p-8 md:ml-16">
        <%= yield %>
      </main>

      <!-- 5. ОВЕРЛЕЙ ДЛЯ МОБИЛКИ -->
      <div data-action="click->reveal#toggle" 
           data-reveal-target="item" 
           class="fixed top-16 inset-0 bg-black/50 z-[55] hidden md:hidden">
      </div>
    </div>
  </div>
</body>
</html>