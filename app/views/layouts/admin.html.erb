<!DOCTYPE html>
<html lang="<%= I18n.locale.to_s %>">
  <head>
    <title><%= content_for(:title) || "Admin - Travel Fi" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0288D1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Travel Fi - Admin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# === RESOURCE HINTS === %>
    <link rel="preload" href="<%= asset_path("application.css") %>" as="style">
    <link rel="modulepreload" href="<%= asset_path("admin.js") %>" crossorigin="anonymous">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="/manifest.json">

    <%# MDI font загружается локально через esbuild (import в admin.js) %>
    <%# CDN больше не используется %>

    <%# === CRITICAL CSS === %>
    <%= critical_css %>

    <%# === ASYNC CSS === %>
    <link rel="stylesheet" href="<%= asset_path("application.css") %>" media="print" onload="this.media='all'">
    <noscript><%= stylesheet_link_tag :app %></noscript>

    <link rel="stylesheet" href="<%= asset_path("components.css") %>" media="print" onload="this.media='all'">
    <noscript><%= stylesheet_link_tag "components" %></noscript>

    <%= javascript_include_tag "admin", type: "module" %>
  </head>

<body class="flex flex-col h-screen overflow-hidden bg-linear-to-br from-primary/5 to-secondary/10" data-controller="cable">

  <!-- 1. ХЕДЕР: Фиксированная высота 64px -->
  <header class="h-16 bg-white border-b shrink-0 relative z-70">
    <%= render Ui::NavbarComponent.new(user: current_user) %>
  </header>

  <!-- 2. ОСНОВНОЙ КОНТЕНТ: сайдбар + страница -->
  <div class="flex flex-1 overflow-hidden">
    <%= render Ui::SidebarComponent.new do %>
      <div class="sticky top-0 bg-white border-b border-gray-200 px-4 py-3 z-10">
        <div class="flex items-center gap-2">
          <i class="mdi mdi-view-dashboard text-primary text-xl"></i>
          <h2 class="text-md font-semibold text-gray-900">Admin Panel</h2>
        </div>
      </div>
      <nav class="py-2">
        <%= link_to admin_root_path(locale: I18n.locale), class: "flex items-center h-11 px-4 text-gray-700 hover:bg-gray-100 hover:text-gray-900 transition-colors" do %>
          <i class="mdi mdi-view-dashboard text-xl mr-3 shrink-0"></i>
          <span class="text-sm whitespace-nowrap">Dashboard</span>
        <% end %>
        <%= link_to admin_users_path(locale: I18n.locale), class: "flex items-center h-11 px-4 text-gray-700 hover:bg-gray-100 hover:text-gray-900 transition-colors" do %>
          <i class="mdi mdi-account-multiple text-xl mr-3 shrink-0"></i>
          <span class="text-sm whitespace-nowrap">Users</span>
        <% end %>
        <%= link_to admin_poi_categories_path(locale: I18n.locale), class: "flex items-center h-11 px-4 text-gray-700 hover:bg-gray-100 hover:text-gray-900 transition-colors" do %>
          <i class="mdi mdi-shape-outline text-xl mr-3 shrink-0"></i>
          <span class="text-sm whitespace-nowrap">POI Categories</span>
        <% end %>
        <%= link_to admin_pois_path(locale: I18n.locale), class: "flex items-center h-11 px-4 text-gray-700 hover:bg-gray-100 hover:text-gray-900 transition-colors" do %>
          <i class="mdi mdi-map-marker-multiple text-xl mr-3 shrink-0"></i>
          <span class="text-sm whitespace-nowrap">POIs</span>
        <% end %>
        <%= link_to admin_settings_path(locale: I18n.locale), class: "flex items-center h-11 px-4 text-gray-700 hover:bg-gray-100 hover:text-gray-900 transition-colors" do %>
          <i class="mdi mdi-cog text-xl mr-3 shrink-0"></i>
          <span class="text-sm whitespace-nowrap">Settings</span>
        <% end %>
      </nav>
      <div class="absolute bottom-0 left-0 right-0 border-t border-gray-200">
        <%= link_to root_path(locale: I18n.locale), class: "flex items-center h-11 px-4 text-gray-500 hover:bg-gray-100 hover:text-gray-700 transition-colors" do %>
          <i class="mdi mdi-home text-xl mr-3 shrink-0"></i>
          <span class="text-sm whitespace-nowrap">Back to Site</span>
        <% end %>
      </div>
    <% end %>

    <main class="flex-1 overflow-y-auto p-4 md:p-8">
      <%= yield %>
    </main>
  </div>

  <!-- 3. Toast notifications: SSR flash + CableReady target -->
  <div id="notifications" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none">
    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <% toast_type = case type.to_s
           when "success" then :success
           when "notice"  then :success
           when "alert"   then :error
           when "error"   then :error
           when "warning" then :warning
           else :info
         end %>
      <%= render Ui::ToastComponent.new(message: message, type: toast_type) %>
    <% end %>
    <% flash.clear %>
  </div>
</body>
</html>
