<!DOCTYPE html>
<html lang="<%= I18n.locale.to_s %>">
  <head>
    <title><%= content_for(:title) || "Travel Fi" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0288D1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Travel Fi">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# === RESOURCE HINTS === %>
    <link rel="preload" href="<%= asset_path("application.css") %>" as="style">
    <link rel="modulepreload" href="<%= asset_path("application.js") %>" crossorigin="anonymous">

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.webp">
    <link rel="manifest" href="/manifest.json">

    <%# MDI font загружается локально через esbuild (import в application.js) %>
    <%# CDN больше не используется %>

    <%# === CRITICAL CSS === %>
    <%= critical_css %>

    <%# === ASYNC CSS === %>
    <link rel="stylesheet" href="<%= asset_path("application.css") %>" media="print" onload="this.media='all'">
    <noscript><%= stylesheet_link_tag :app %></noscript>

    <%# MDI иконки — CDN, асинхронно %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css" media="print" onload="this.media='all'">

    <link rel="stylesheet" href="<%= asset_path("components.css") %>" media="print" onload="this.media='all'">
    <noscript><%= stylesheet_link_tag "components" %></noscript>

    <%= javascript_include_tag "application", type: "module" %>
  </head>

  <body class="flex flex-col min-h-screen bg-linear-to-br from-primary/5 to-secondary/10" data-controller="cable" data-current-user-id="<%= current_user&.id %>" data-user-role="<%= current_user&.admin? ? 'admin' : (current_user&.moderator? ? 'moderator' : '') %>">

    <%# Полноэкранный спиннер загрузки (Ui::SpinnerComponent). Появляется ПЕРВЫМ,
        скрывается после полной загрузки страницы. %>
    <%= render Ui::SpinnerComponent.new %>

    <!-- 1. ХЕДЕР: Фиксированная высота 64px -->
    <header class="h-16 border-b shrink-0 relative z-70">
      <%= render Ui::NavbarComponent.new(user: current_user) %>
    </header>

    <!-- 2. ОСНОВНОЙ КОНТЕНТ -->
    <div class="flex-1 <%= content_for(:content_class) || "overflow-y-auto p-4 md:p-8" %>">
      <%= yield %>
    </div>

    <!-- 3. Toast notifications: SSR flash + CableReady target -->
    <div id="notifications" class="fixed top-20 right-4 z-50 flex flex-col gap-2 pointer-events-none">
      <% flash.each do |type, message| %>
        <% next if message.blank? %>
        <% toast_type = case type.to_s
             when "success" then :success
             when "notice"  then :success
             when "alert"   then :error
             when "error"   then :error
             when "warning" then :warning
             else :info
           end %>
        <%= render Ui::ToastComponent.new(message: message, type: toast_type) %>
      <% end %>
      <% flash.clear %>
    </div>

  </body>
</html>
