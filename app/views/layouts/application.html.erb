<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Travel Fi" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Travel Fi">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Use CDN for Material Design Icons to ensure latest version and reduce asset size (optional) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css">

    <%= stylesheet_link_tag :app %>
    <%= javascript_include_tag "application", type: "module" %>
  </head>

  <body class="flex flex-col min-h-screen" data-controller="cable">
    <!-- Navbar Section -->
    <div class="flex-none">
      <%= render NavbarComponent.new(user: current_user) %>
    </div>

    <!-- Content Section -->
    <div class="flex-1 overflow-y-auto p-4">
      <%= yield %>
    </div>
  </body>
</html>