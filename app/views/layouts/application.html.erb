<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Travel Fi" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Travel Fi">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# === RESOURCE HINTS (для ранней загрузки критических ресурсов) === %>
    <link rel="preload" href="<%= asset_path("application.css") %>" as="style">
    <link rel="modulepreload" href="<%= asset_path("application.js") %>" crossorigin="anonymous">

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# MDI font загружается локально через esbuild (import в application.js) %>
    <%# CDN больше не используется — @mdi/font включён в сборку %>

    <%# === CRITICAL CSS (inline, не блокирует рендеринг) === %>
    <%= critical_css %>

    <%# === ASYNC CSS (загружаются без блокировки рендеринга) === %>
    <%# Основной CSS: Tailwind + OpenLayers + MDI (через @import) %>
    <link rel="stylesheet" href="<%= asset_path("application.css") %>" media="print" onload="this.media='all'">
    <noscript><%= stylesheet_link_tag :app %></noscript>

    <%# Компонентный CSS (sidecar) %>
    <link rel="stylesheet" href="<%= asset_path("components.css") %>" media="print" onload="this.media='all'">
    <noscript><%= stylesheet_link_tag "components" %></noscript>

    <%# JS — modulepreload уже указан выше, этот тег запускает выполнение %>
    <%= javascript_include_tag "application", type: "module" %>
  </head>

  <body class="flex flex-col min-h-screen bg-linear-to-br from-primary/5 to-secondary/10" data-controller="cable">
    <!-- Navbar Section -->
    <div class="flex-none">
      <%= render Ui::NavbarComponent.new(user: current_user) %>
    </div>

    <!-- Content Section -->
    <div class="flex-1 <%= content_for(:content_class) || "overflow-y-auto p-4" %>">
      <%= yield %>
    </div>

    <!-- Toast notifications: SSR flash + CableReady target -->
    <div id="notifications" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none">
      <% flash.each do |type, message| %>
        <% next if message.blank? %>
        <% toast_type = case type.to_s
             when "success" then :success
             when "notice"  then :success
             when "alert"   then :error
             when "error"   then :error
             when "warning" then :warning
             else :info
           end %>
        <%= render Ui::ToastComponent.new(message: message, type: toast_type) %>
      <% end %>
      <% flash.clear %>
    </div>
  </body>
</html>
