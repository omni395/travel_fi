<!-- Users Edit Page -->
<!-- Отображает форму редактирования профиля через UsersFormComponent -->
<div class="min-h-screen py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <!-- Back Button -->
    <div class="mb-6">
      <%= link_to user_path(id: @user), class: "inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors duration-200" do %>
        <i class="mdi mdi-arrow-left mr-2"></i>
        <%= t('common.back') %>
      <% end %>
    </div>

    <!-- Users Form Component -->
    <%= render Users::FormComponent.new(user: @user) %>
  </div>
</div>
