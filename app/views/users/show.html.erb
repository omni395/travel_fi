<!-- Users Show Page -->
<!-- Отображает профиль пользователя через UserProfileComponent -->
<div class="min-h-screen py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <!-- Back Button -->
    <div class="mb-6">
      <%= link_to root_path, class: "inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors duration-200" do %>
        <i class="mdi mdi-arrow-left mr-2"></i>
        <%= t('common.back') %>
      <% end %>
    </div>

    <!-- User Profile Component (обёртка-цель для CableReady inner_html) -->
    <div data-user-profile-id="<%= @user.id %>">
      <%= render Users::ProfileComponent.new(user: @user) %>
    </div>
  </div>
</div>
