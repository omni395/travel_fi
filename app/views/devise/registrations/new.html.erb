<%# frozen_string_literal: true %>

<%#
# app/views/devise/registrations/new.html.erb - форма регистрации
#
# Единый стиль с primary цветовой схемой.
# Использует field-input, field-label, btn-ui классы.
# Аватар — кликабельный с badge-индикатором.
# %>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-4 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md">
    <%# Header %>
    <div class="text-center mb-2">
      <h1 class="text-4xl font-bold text-primary mb-2">Travel-Fi</h1>
      <h2 class="text-2xl font-bold text-gray-900"><%= t('devise.registrations.new.title') %></h2>
      <p class="text-gray-600 mt-2"><%= t('devise.registrations.new.subtitle') %></p>
    </div>

    <%# Sign Up Form %>
    <div id="devise_registration_form" class="bg-white rounded-xl shadow-lg p-6 mb-2">
      <%= form_with(model: resource, as: resource_name, url: registration_path(resource_name), html: { multipart: true }) do |form| %>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <% if resource.errors.any? %>
          <div class="alert-ui alert-ui--error mb-4">
            <ul class="list-disc list-inside">
              <% resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%# Email %>
        <div class="field-group mb-4">
          <%= form.label :email, class: "field-label" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "field-input", placeholder: t('devise.registrations.new.email_placeholder') %>
        </div>

        <%# Name + Avatar (stack на mobile, строка на desktop) %>
        <div class="flex flex-col sm:flex-row gap-3 mb-4">
          <div class="field-group flex-1">
            <%= form.label :name, class: "field-label" %>
            <%= form.text_field :name, value: "", autocomplete: "off", class: "field-input", placeholder: t('devise.registrations.new.name_placeholder') %>
          </div>
          <div class="field-group sm:w-auto shrink-0">
            <%= form.label :avatar, class: "field-label" %>
            <%= form.file_field :avatar, id: "user_avatar_input", accept: 'image/png,image/jpeg,image/webp', class: "hidden" %>
            <%= render Ui::BtnComponent.new(color: :secondary, size: :md, html: { type: "button", onclick: "document.getElementById('user_avatar_input').click()" }) do %>
              <!-- mdi: camera-plus -->
              <i class="mdi mdi-camera-plus"></i>
            <% end %>
          </div>
        </div>

        <%# Password + Confirmation (stack на mobile, строка на desktop) %>
        <div class="flex flex-col sm:flex-row gap-3 mb-4">
          <div class="field-group flex-1">
            <%= form.label :password, class: "field-label" %>
            <%= form.password_field :password, autocomplete: "new-password", class: "field-input", placeholder: t('devise.registrations.new.password_placeholder') %>
          </div>
          <div class="field-group flex-1">
            <%= form.label :password_confirmation, class: "field-label" %>
            <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "field-input", placeholder: t('devise.registrations.new.password_placeholder') %>
          </div>
        </div>

        <%# Referral Code (открытое поле, предзаполняется из params[:ref]) %>
        <div class="field-group mb-4">
          <%= form.label :referral_code_input, class: "field-label" %>
          <%= form.text_field :referral_code_input,
                value: params[:ref],
                autocomplete: "off",
                class: "field-input",
                placeholder: t('devise.registrations.new.referral_placeholder') %>
          <p class="text-xs text-gray-500 mt-1">
            <!-- mdi: information-outline -->
            <i class="mdi mdi-information-outline text-gray-400 mr-1"></i>
            <%= t('devise.registrations.new.referral_hint') %>
          </p>
        </div>

        <%# Sign Up Button %>
        <div class="mb-4">
          <%= render Ui::BtnComponent.new(color: :primary, size: :md, html: { type: "submit", class: "w-full" }) do %>
            <%= t('devise.registrations.new.submit') %>
          <% end %>
        </div>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
