<%# frozen_string_literal: true %>

<%#
# app/views/devise/sessions/new.html.erb - форма входа
#
# Единый стиль с primary цветовой схемой.
# Использует field-input, field-label, btn-ui классы.
# %>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-4 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md">
    <%# Header %>
    <div class="text-center mb-2">
      <h1 class="text-4xl font-bold text-teal-600 mb-2">Travel-Fi</h1>
      <h2 class="text-2xl font-bold text-gray-900"><%= t('devise.sessions.new.title') %></h2>
      <p class="text-gray-600 mt-2"><%= t('devise.sessions.new.subtitle') %></p>
    </div>

    <%# Sign In Form %>
    <div id="devise_session_form" class="bg-white rounded-xl shadow-lg p-6 mb-2">
      <%= form_with(model: resource, as: resource_name, url: session_path(resource_name)) do |form| %>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <% if resource.errors.any? %>
          <div class="alert-ui alert-ui--error mb-4">
            <ul class="list-disc list-inside">
              <% resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%# Email %>
        <div class="field-group mb-4">
          <%= form.label :email, class: "field-label" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "field-input", placeholder: t('devise.sessions.new.email_placeholder') %>
        </div>

        <%# Password %>
        <div class="field-group mb-4">
          <%= form.label :password, class: "field-label" %>
          <%= form.password_field :password, autocomplete: "current-password", class: "field-input" %>
        </div>

        <%# Remember Me %>
        <div class="mb-4 flex items-center">
          <%= form.check_box :remember_me, class: "field-checkbox" %>
          <%= form.label :remember_me, t('devise.sessions.new.remember_me'), class: "ml-2 block text-sm text-gray-700" %>
        </div>

        <%# Sign In Button %>
        <div class="mb-4">
          <%= form.submit t('devise.sessions.new.submit'), class: "btn-ui btn-ui--primary btn-ui--md w-full" %>
        </div>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
