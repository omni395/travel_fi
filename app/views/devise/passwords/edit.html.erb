<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-4 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md">
    <%# Header %>
    <div class="text-center mb-2">
      <h1 class="text-4xl font-bold text-teal-600 mb-2">Travel-Fi</h1>
      <h2 class="text-2xl font-bold text-gray-900"><%= t('devise.passwords.edit.heading', default: 'Reset Password') %></h2>
      <p class="text-gray-600 mt-2"><%= t('devise.passwords.edit.subheading', default: 'Enter your new password below') %></p>
    </div>

    <%# Reset Password Form %>
    <div id="devise_password_edit_form" class="bg-white rounded-xl shadow-lg p-6 mb-2">
      <%= form_with(model: resource, as: resource_name, url: password_path(resource_name), method: :patch) do |form| %>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <% if resource.errors.any? %>
          <div class="alert-ui alert-ui--error mb-4">
            <ul class="list-disc list-inside">
              <% resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form.hidden_field :reset_password_token, autocomplete: "off" %>

        <%# New Password %>
        <div class="field-group mb-4">
          <%= form.label :password, class: "field-label" %>
          <%= form.password_field :password, autocomplete: "new-password", class: "field-input", placeholder: t('devise.passwords.edit.password_hint', default: 'At least 8 characters') %>
          <p class="text-xs text-gray-500 mt-1"><%= t('devise.passwords.edit.password_requirements', default: 'Minimum 8 characters required') %></p>
        </div>

        <%# Confirm Password %>
        <div class="field-group mb-4">
          <%= form.label :password_confirmation, class: "field-label" %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "field-input" %>
        </div>

        <%# Submit Button %>
        <div class="mb-4">
          <%= render Ui::BtnComponent.new(color: :primary, size: :md, html: { type: "submit", class: "w-full" }) do %>
            <%= t('devise.passwords.edit.submit_button', default: 'Change Password') %>
          <% end %>
        </div>
      <% end %>

      <%# Back to Sign In %>
      <div class="text-center">
        <%= link_to t('devise.passwords.edit.back_to_signin', default: 'Back to Sign In'), new_user_session_path, class: "text-teal-600 hover:text-teal-700 text-sm font-medium" %>
      </div>
    </div>
  </div>
</div>
