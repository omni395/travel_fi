<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center py-2 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md">
    <!-- Header -->
    <div class="text-center mb-2">
      <h1 class="text-4xl font-bold text-indigo-600 mb-2">Travel-Fi</h1>
      <h2 class="text-2xl font-bold text-gray-900"><%= t('devise.passwords.edit.heading', default: 'Reset Password') %></h2>
      <p class="text-gray-600 mt-2"><%= t('devise.passwords.edit.subheading', default: 'Enter your new password below') %></p>
    </div>

    <!-- Reset Password Form -->
    <div id="devise_password_edit_form" class="bg-white rounded-xl shadow-lg p-6 mb-2">
      <%= form_with(model: resource, as: resource_name, url: password_path(resource_name), method: :patch) do |form| %>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <% if resource.errors.any? %>
          <div class="mb-2 p-4 bg-red-50 border border-red-200 rounded-lg">
            <h4 class="text-red-800 font-bold mb-2"><%= pluralize(resource.errors.count, "error") %> prohibited password reset:</h4>
            <ul class="list-disc list-inside text-red-700">
              <% resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Hidden reset_password_token -->
        <%= form.hidden_field :reset_password_token, autocomplete: "off" %>

        <!-- New Password -->
        <div class="mb-2">
          <%= form.label :password, t('devise.passwords.edit.password_label', default: 'New Password'), class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent", placeholder: t('devise.passwords.edit.password_hint', default: 'At least 8 characters') %>
          <p class="text-xs text-gray-500 mt-1"><%= t('devise.passwords.edit.password_requirements', default: 'Minimum 8 characters required') %></p>
        </div>

        <!-- Confirm Password -->
        <div class="mb-2">
          <%= form.label :password_confirmation, t('devise.passwords.edit.password_confirmation_label', default: 'Confirm Password'), class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
        </div>

        <!-- Submit Button -->
        <div class="mb-2">
          <%= form.submit t('devise.passwords.edit.submit_button', default: 'Change Password'), class: "w-full px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-medium cursor-pointer" %>
        </div>
      <% end %>

      <!-- Back to Sign In -->
      <div class="text-center">
        <%= link_to t('devise.passwords.edit.back_to_signin', default: 'Back to Sign In'), new_user_session_path, class: "text-indigo-600 hover:text-indigo-700 text-sm font-medium" %>
      </div>
    </div>
  </div>
</div>
