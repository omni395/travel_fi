<div class="p-8 space-y-12 bg-base-200">
  
  <div class="text-center">
    <h1 class="text-4xl font-extrabold">Full Component Audit</h1>
    <p class="text-gray-500">Проверка иконок: <i class="mdi mdi-check-decagram text-success"></i> <i class="mdi mdi-alert-circle text-error"></i></p>
  </div>

  <div role="alert" class="alert alert-info">
    <i class="mdi mdi-information text-xl"></i>
    <span>Alert component is visible.</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <div class="dropdown dropdown-end">
          <label tabindex="0" class="btn btn-primary">
            Dropdown <i class="mdi mdi-chevron-down ml-2"></i>
          </label>
          <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-52">
            <li><a>Test Item 1</a></li>
            <li><a>Test Item 2</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <button onclick="my_modal.showModal()" class="btn btn-primary">
          Open Modal
        </button>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl md:col-span-2">
      <div class="card-body">
        <div role="tablist" class="tabs tabs-boxed">
          <input type="radio" name="my_tabs_1" role="tab" class="tab" aria-label="Tab 1" checked />
          <div role="tabpanel" class="tab-content tab-content-1 p-4 bg-base-200 rounded-lg">Content A</div>
          <input type="radio" name="my_tabs_1" role="tab" class="tab" aria-label="Tab 2" />
          <div role="tabpanel" class="tab-content tab-content-2 p-4 bg-base-200 rounded-lg hidden">Content B</div>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl md:col-span-2">
      <div class="card-body">
        <div class="collapse collapse-arrow bg-base-200">
          <input type="radio" name="my-accordion-2" checked="checked" />
          <div class="collapse-title text-xl font-medium">
            Accordion Test
          </div>
          <div class="collapse-content">
            <p>Accordion body is working if you can see this.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <div class="flex gap-4">
          <div class="tooltip" data-tip="Tooltip content">
            <button class="btn btn-primary">Tooltip</button>
          </div>
      
          <div class="dropdown dropdown-end">
            <label tabindex="0" class="btn btn-primary">Popover</label>
            <div tabindex="0" class="dropdown-content z-[1] card card-compact w-64 p-2 shadow bg-base-100 text-base-content">
              <div class="card-body">
                <h3 class="card-title text-sm">Popover title</h3>
                <p>And here's some amazing content.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <label for="my-drawer" class="btn btn-primary">
          Show Drawer
        </label>
      </div>
    </div>
  </div>
</div>

<dialog id="my_modal" class="modal">
  <div class="modal-box">
    <h3 class="font-bold text-lg">Modal Header</h3>
    <p class="py-4">Modal is working!</p>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn">Close</button>
      </form>
    </div>
  </div>
</dialog>

<div id="drawer-example" class="drawer drawer-end">
  <input id="my-drawer" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content">
    <label for="my-drawer" class="drawer-overlay"></label>
  </div>
  <div class="drawer-side">
    <label for="my-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
    <ul class="menu p-4 w-80 min-h-full bg-base-200 text-base-content">
      <li><a>Sidebar Item 1</a></li>
      <li><a>Sidebar Item 2</a></li>
    </ul>
  </div>
</div>