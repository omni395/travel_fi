<%# Ui::HamburgerComponent — гамбургер-меню на базе Ui::DropdownComponent %>
<%= render Ui::DropdownComponent.new(position: position, menu_classes: menu_classes) do |dropdown| %>
  <% dropdown.with_trigger do %>
    <% if trigger.present? %>
      <%= trigger %>
    <% else %>
      <%= render Ui::BtnComponent.new(
            color: btn_color,
            size: btn_size,
            html: {
              aria: { label: t(".toggle", default: "Toggle navigation menu") },
              data: { action: "click->ui--dropdown-component#toggle" },
              class: "focus:outline-none focus:ring-2 focus:ring-primary/50"
            }
          ) do %>
        <i class="mdi mdi-menu text-xl"></i>
      <% end %>
    <% end %>
  <% end %>

  <% dropdown.with_menu do %>
    <div class="py-1 min-w-[200px]">
      <% if menu.present? %>
        <%= menu %>
      <% else %>
        <div class="px-4 py-2 text-sm text-secondary">
          <%= t(".empty", default: "No items") %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
