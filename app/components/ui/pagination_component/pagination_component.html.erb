<%# frozen_string_literal: true %>
<%#
# app/components/ui/pagination_component.html.erb
#
# Компонент пагинации.
# Кнопки используют data-action для StimulusReflex (без перезагрузки страницы)
# %>
<div data-controller="ui--pagination-component" class="flex justify-center py-3">
  <nav class="inline-flex items-center gap-0.5" aria-label="<%= t('.navigation') %>">
    <%# Кнопка "Назад" %>
    <% if pagy.previous %>
      <button type="button"
         class="btn-ui btn-ui--ghost btn-ui--sm min-w-8"
         aria-label="<%= t('.previous') %>"
         data-action="click-><%= pagination_controller %>#goToPage"
         data-page="<%= pagy.previous %>">
        <!-- mdi: chevron-left -->
        <span class="mdi mdi-chevron-left"></span>
      </button>
    <% else %>
      <span class="btn-ui btn-ui--ghost btn-ui--sm min-w-8 opacity-30 cursor-not-allowed">
        <!-- mdi: chevron-left -->
        <span class="mdi mdi-chevron-left"></span>
      </span>
    <% end %>

    <%# Серия страниц %>
    <% series.each do |item| %>
      <% if item.is_a?(Integer) %>
        <% if item == pagy.page %>
          <span class="btn-ui btn-ui--primary btn-ui--sm min-w-8"><%= item %></span>
        <% else %>
          <button type="button"
             class="btn-ui btn-ui--ghost btn-ui--sm min-w-8"
             data-action="click-><%= pagination_controller %>#goToPage"
             data-page="<%= item %>">
            <%= item %>
          </button>
        <% end %>
      <% elsif item == :gap %>
        <span class="btn-ui btn-ui--ghost btn-ui--sm min-w-8 opacity-30 cursor-not-allowed">...</span>
      <% end %>
    <% end %>

    <%# Кнопка "Вперед" %>
    <% if pagy.next %>
      <button type="button"
         class="btn-ui btn-ui--ghost btn-ui--sm min-w-8"
         aria-label="<%= t('.next') %>"
         data-action="click-><%= pagination_controller %>#goToPage"
         data-page="<%= pagy.next %>">
        <!-- mdi: chevron-right -->
        <span class="mdi mdi-chevron-right"></span>
      </button>
    <% else %>
      <span class="btn-ui btn-ui--ghost btn-ui--sm min-w-8 opacity-30 cursor-not-allowed">
        <!-- mdi: chevron-right -->
        <span class="mdi mdi-chevron-right"></span>
      </span>
    <% end %>
  </nav>
</div>
