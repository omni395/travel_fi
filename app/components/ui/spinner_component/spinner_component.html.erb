<%# Ui::SpinnerComponent — полноэкранный оверлей загрузки %>
<div data-controller="ui--spinner-component"
     data-ui--spinner-component-target="overlay"
     role="status"
     aria-live="polite"
     class="spinner-overlay fixed inset-0 z-100 flex flex-col items-center justify-center gap-6 bg-white transition-opacity duration-300">

  <%# Контейнер для спиннера и логотипа. Задан жесткий размер w-24 h-24, чтобы абсолютное кольцо не сжималось %>
  <div class="spinner-box relative flex items-center justify-center w-24 h-24">
    <%# Вращающееся кольцо вокруг логотипа — теперь оно крутится по внешнему радиусу (w-24 h-24) %>
    <span class="absolute inset-0 rounded-full border-4 border-primary/20 border-t-primary animate-spin" aria-hidden="true"></span>

    <%# Внутренний контейнер под логотип (размер w-20 h-20). Он меньше кольца, поэтому они не пересекаются %>
    <div class="spinner-logo z-10 w-20 h-20 rounded-full bg-white shadow-lg overflow-hidden flex items-center justify-center p-2">
      <%= image_tag "logo_title.webp", class: "w-full h-full object-contain", alt: t(".loading") %>
    </div>
  </div>

  <%# Процент загрузки %>
  <div class="flex flex-col items-center gap-1">
    <span data-ui--spinner-component-target="progress" class="text-lg font-semibold text-primary">0%</span>
    <span class="text-sm text-secondary opacity-80"><%= t(".loading") %></span>
  </div>
</div>
