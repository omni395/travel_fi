<%# Ui::SidebarComponent — универсальная обёртка сайдбара %>
<div class="ui-sidebar--wrapper <%= state_class %>"
     data-controller="<%= controller_names %>"
     data-ui--sidebar-component-target="wrapper">

  <%# Сайдбар фиксирован, overflow-x скрыт %>
  <aside class="ui-sidebar"
         data-ui--sidebar-component-target="sidebar">
    <%# Обертка контента берет ширину @width_class %>
    <div class="ui-sidebar--content <%= @width_class %>">
      <%= content %>
    </div>
  </aside>

  <!-- Кнопка переключения сайдбара (шеврон) -->
  <button type="button"
          data-action="click->ui--sidebar-component#sidebarToggle"
          data-ui--sidebar-component-target="chevron"
          aria-label="<%= t(".toggle") %>"
          class="ui-sidebar--chevron bg-white border border-l-0 border-gray-200 px-1 py-2 flex items-center justify-center
                 hover:bg-gray-50 cursor-pointer">
    <i class="mdi mdi-chevron-double-right text-gray-500"></i>
  </button>
</div>
