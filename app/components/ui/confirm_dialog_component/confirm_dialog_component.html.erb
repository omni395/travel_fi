<%# Ui::ConfirmDialogComponent - модальное окно подтверждения %>
<div id="<%= dialog_id %>"
     data-controller="ui--confirm-dialog-component"
     data-ui--confirm-dialog-component-confirm-url-value="<%= confirm_url %>"
     data-ui--confirm-dialog-component-confirm-method-value="<%= confirm_method %>"
     class="fixed inset-0 z-50 hidden"
     data-action="keydown.esc->ui--confirm-dialog-component#cancel">

  <%# Фон с плавной прозрачностью %>
  <div class="absolute inset-0 bg-black/50 transition-opacity animate-[fadeIn_0.2s_ease-out]" 
       data-action="click->ui--confirm-dialog-component#cancel"></div>

  <div class="absolute inset-0 flex items-center justify-center p-4">
    <%# Модалка %>
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md p-6 relative z-10 animate-[scaleIn_0.2s_ease-out]">

      <%# Шапка: Иконка + Заголовок + Крестик закрытия %>
      <div class="flex items-start justify-between gap-3 mb-4">
        <div class="flex items-center gap-3">
          <% if confirm_variant == :danger %>
            <%# Иконка ошибки/опасности %>
            <div class="w-5 h-5 rounded-full bg-error/10 flex items-center justify-center shrink-0">
              <i class="mdi mdi-alert-circle text-error text-xl" aria-hidden="true"></i>
            </div>
          <% else %>
            <%# Иконка инфо %>
            <div class="w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
              <i class="mdi mdi-information-outline text-primary text-xl" aria-hidden="true"></i>
            </div>
          <% end %>
          <h3 class="text-lg font-semibold text-gray-900"><%= title.presence || t(".default_title") %></h3>
        </div>

        <%# Крестик закрытия %>
        <%= render Ui::BtnComponent.new(
              color: :ghost,
              size: :sm,
              html: {
                data: { action: "click->ui--confirm-dialog-component#cancel" },
                aria: { label: t(".close", default: "Close") }
              }
            ) do %>
          <i class="mdi mdi-close text-xl text-gray-400 hover:text-gray-600 transition-colors" aria-hidden="true"></i>
        <% end %>
      </div>

      <%# Тело: Сообщение %>
      <% if message.present? %>
        <p class="text-sm text-gray-600 mb-6"><%= message %></p>
      <% end %>

      <%# Футер: Кнопки %>
      <div class="flex justify-end gap-3">
        <%= render Ui::BtnComponent.new(
              color: :secondary,
              size: :md,
              html: { data: { action: "click->ui--confirm-dialog-component#cancel" } }
            ) do %>
          <%= cancel_text.presence || t(".cancel") %>
        <% end %>

        <%= render Ui::BtnComponent.new(
              color: confirm_variant == :danger ? :danger : :primary,
              size: :md,
              html: { data: { action: "click->ui--confirm-dialog-component#confirm" } }
            ) do %>
          <%= confirm_text.presence || t(".confirm") %>
        <% end %>
      </div>
    </div>
  </div>
</div>