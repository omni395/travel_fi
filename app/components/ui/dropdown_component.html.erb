<%# DropdownComponent - универсальный компонент для выпадающего меню %>
<%# Использует stimulus-components/dropdown для управления состоянием %>

<div data-controller="dropdown" class="relative">
  <%# Кнопка-триггер %>
  <% if trigger.present? %>
    <%= trigger %>
  <% end %>

  <%# Выпадающее меню %>
  <div
    data-dropdown-target="menu"
    class="hidden transition transform origin-top-right absolute <%= position_class %> <%= menu_classes %>"
    data-transition-enter-from="opacity-0 scale-95"
    data-transition-enter-to="opacity-100 scale-100"
    data-transition-leave-from="opacity-100 scale-100"
    data-transition-leave-to="opacity-0 scale-95"
  >
    <% if menu.present? %>
      <%= menu %>
    <% end %>
  </div>
</div>
