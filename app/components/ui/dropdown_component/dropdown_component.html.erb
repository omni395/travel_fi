<%# Ui::DropdownComponent - универсальный компонент для выпадающего меню %>
<%# Иконка: mdi-chevron-down %>
<div data-controller="ui--dropdown-component" class="relative inline-block text-left">

  <%# Триггер: Переданный слот ИЛИ дефолтная кнопка с Ui::BtnComponent %>
  <% if trigger.present? %>
    <%= trigger %>
  <% else %>
    <%= render Ui::BtnComponent.new(
          color: :secondary,
          size: :md,
          html: { data: { action: "click->ui--dropdown-component#toggle" } }
        ) do %>
      <span><%= t(".options", default: "Options") %></span>
      <i class="mdi mdi-chevron-down text-lg" aria-hidden="true"></i>
    <% end %>
  <% end %>

  <%# Добавили whitespace-nowrap для запрета переноса текста внутри плашки %>
  <div
    data-ui--dropdown-component-target="menu"
    class="hidden transition transform absolute z-50 mt-2 min-w-[12rem] w-max whitespace-nowrap rounded-xl shadow-xl ring-1 ring-black/5 py-1 focus:outline-none <%= menu_classes.present? ? menu_classes : "bg-white text-gray-700" %> <%= position_class %>"
    data-transition-enter-from="opacity-0 scale-95"
    data-transition-enter-to="opacity-100 scale-100"
    data-transition-leave-from="opacity-100 scale-100"
    data-transition-leave-to="opacity-0 scale-95"
  >
    <% if menu.present? %>
      <div class="py-1">
        <%= menu %>
      </div>
    <% end %>
  </div>
</div>
