<%# Ui::DropdownComponent - универсальный компонент для выпадающего меню %>
<%# Иконка: mdi-chevron-down %>
<div data-controller="ui--dropdown-component" class="relative">
  <%# Кнопка-триггер %>
  <% if trigger.present? %>
    <%= trigger %>
  <% end %>

  <%# Выпадающее меню с базовыми стилями %>
  <%# menu_classes переопределяет цвет фона и текста при необходимости %>
  <div
    data-ui--dropdown-component-target="menu"
    class="hidden transition transform origin-top-right absolute z-50 rounded-lg shadow-lg py-1 <%= position_class %> <%= menu_classes %>"
    data-transition-enter-from="opacity-0 scale-95"
    data-transition-enter-to="opacity-100 scale-100"
    data-transition-leave-from="opacity-100 scale-100"
    data-transition-leave-to="opacity-0 scale-95"
  >
    <% if menu.present? %>
      <%= menu %>
    <% end %>
  </div>
</div>
