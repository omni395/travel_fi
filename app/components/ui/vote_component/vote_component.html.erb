<%# Ui::VoteComponent — блок голосования сообщества %>
<%# Иконка: mdi-thumb-up-outline (апрув) / mdi-thumb-down-outline (дизлайк) %>
<div
  class="flex flex-col gap-2"
  data-controller="ui--vote-component"
  data-vote-component-votable-type-value="<%= votable.class.name %>"
  data-vote-component-votable-id-value="<%= votable.id %>"
  data-vote-component-current-vote-value="<%= current_vote_value %>"
>
  <%# Идеально сжатый однострочный блок %>
  <div class="inline-flex items-center gap-2">
    <%# Кнопка «Апрув» (+1) %>
    <%= render Ui::BtnComponent.new(
          color: user_voted_up? ? :success : :ghost,
          size: :sm,
          html: {
            type: "button",
            class: "!px-0 border-0 shadow-none inline-flex items-center gap-1 text-success hover:bg-transparent transition-colors disabled:cursor-not-allowed disabled:opacity-50 #{'is-active' if user_voted_up?}",
            data: { action: "click->ui--vote-component#castUp" },
            aria: { label: t(".up_aria") },
            disabled: !can_vote?
          }
        ) do %>
      <span class="mdi mdi-thumb-up-outline text-success text-base leading-none" aria-hidden="true"></span>
      <span class="font-semibold text-xs leading-none" data-vote-counter="up"><%= ups %></span>
    <% end %>

    <%# Кнопка «Дизлайк» (-1) %>
    <%= render Ui::BtnComponent.new(
          color: user_voted_down? ? :error : :ghost,
          size: :sm,
          html: {
            type: "button",
            class: "!px-0 border-0 shadow-none inline-flex items-center gap-1 text-error hover:bg-transparent transition-colors disabled:cursor-not-allowed disabled:opacity-50 #{'is-active--down' if user_voted_down?}",
            data: { action: "click->ui--vote-component#castDown" },
            aria: { label: t(".down_aria") },
            disabled: !can_vote?
          }
        ) do %>
      <span class="mdi mdi-thumb-down-outline text-error text-base leading-none" aria-hidden="true"></span>
      <span class="font-semibold text-xs leading-none" data-vote-counter="down"><%= downs %></span>
    <% end %>

    <%# Общее количество голосов %>
    <span class="text-xs text-secondary-text leading-none ml-1" data-vote-counter="hint">
      <%= t(".hint", total: total) %>
    </span>
  </div>

  <%# Диалог «забрать голос» %>
  <div
    data-ui--vote-component-target="removeDialog"
    data-action="confirmDialogConfirmed->ui--vote-component#onRemoveConfirmed"
  >
    <%= render Ui::ConfirmDialogComponent.new(
      title: t(".remove_title"),
      message: t(".remove_message"),
      confirm_text: t(".remove_confirm"),
      cancel_text: t(".cancel"),
      confirm_variant: :danger,
      confirm_url: nil
    ) %>
  </div>

  <%# Диалог «изменить голос» %>
  <div
    data-ui--vote-component-target="changeDialog"
    data-action="confirmDialogConfirmed->ui--vote-component#onChangeConfirmed"
  >
    <%= render Ui::ConfirmDialogComponent.new(
      title: t(".change_title"),
      message: t(".change_message"),
      confirm_text: t(".change_confirm"),
      cancel_text: t(".cancel"),
      confirm_variant: :primary,
      confirm_url: nil
    ) %>
  </div>
</div>
