<%# frozen_string_literal: true %>
<%#
# Ui::TabsComponent - универсальный компонент для вкладок
%>
<div class="bg-primary border border-secondary rounded-xl shadow-sm overflow-hidden"
     data-controller="ui--tabs-component"
     data-ui--tabs-component-active-tab-value="<%= active_tab %>">
  <%# Навигация табов %>
  <nav class="flex p-1.5 gap-1 bg-secondary/30 border-b border-secondary">
    <% tabs.each do |tab| %>
      <% is_active = active_tab.to_s == tab[:id].to_s %>
      <button type="button"
              class="tab-button flex-1 inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg transition-all border border-secondary cursor-pointer text-secondary hover:text-primary <%= 'is-active bg-primary text-primary shadow-sm border-secondary font-bold' if is_active %>"
              data-ui--tabs-component-target="tab"
              data-action="click->ui--tabs-component#switch"
              data-tab="<%= tab[:id] %>">
        <% if tab[:icon].present? %>
          <i class="mdi <%= tab[:icon] %> text-base"></i>
        <% end %>
        <span><%= tab[:name] %></span>
      </button>
    <% end %>
  </nav>

  <%# Панели содержимого %>
  <% tabs.each_with_index do |tab, index| %>
    <% content = panel_content(tab[:id]) %>
    <div class="<%= 'hidden' unless active_tab.to_s == tab[:id].to_s %> p-6 text-primary text-sm"
         data-ui--tabs-component-target="panel"
         data-tab="<%= tab[:id] %>">
      <% if content.present? %>
        <%= content %>
      <% else %>
        <div class="text-center py-8 text-secondary opacity-60">
          <i class="mdi mdi-inbox-outline text-4xl mb-2 block"></i>
          <p><%= t(".no_data") %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
