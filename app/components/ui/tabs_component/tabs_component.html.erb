<%# frozen_string_literal: true %>
<%#
# Ui::TabsComponent - универсальный компонент для вкладок
%>
<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden"
     data-controller="ui--tabs-component"
     data-ui--tabs-component-active-tab-value="<%= active_tab %>">
  <%# Навигация табов %>
  <nav class="flex p-1 gap-1 bg-slate-100/50">
    <% tabs.each do |tab| %>
      <button type="button"
              class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-semibold text-slate-500 hover:text-slate-700 hover:bg-white/50 rounded-lg transition-all"
              data-ui--tabs-component-target="tab"
              data-action="click->ui--tabs-component#switch"
              data-tab="<%= tab[:id] %>">
        <% if tab[:icon].present? %>
          <i class="mdi <%= tab[:icon] %> text-base"></i>
        <% end %>
        <%= tab[:name] %>
      </button>
    <% end %>
  </nav>

  <%# Панели содержимого %>
  <% tabs.each_with_index do |tab, index| %>
    <% content = panel_content(tab[:id]) %>
    <div class="<%= 'hidden' if index > 0 && active_tab.to_s != tab[:id].to_s %> p-6 text-slate-600 text-sm"
         data-ui--tabs-component-target="panel"
         data-tab="<%= tab[:id] %>">
      <% if content.present? %>
        <%= content %>
      <% else %>
        <div class="text-center py-8 text-gray-400">
          <i class="mdi mdi-inbox-outline text-4xl mb-2"></i>
          <p><%= t(".no_data") %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
