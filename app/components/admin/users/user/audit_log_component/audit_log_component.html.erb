<%# frozen_string_literal: true %>

<%#
# app/components/admin/users/user/audit_log_component.html.erb
#
# Компонент аудит-лога пользователя.
# Отображает ВСЮ историю изменений из PaperTrail с полным diff.
#
# @param versions [Array<PaperTrail::Version>] история изменений
# %>

<div id="user-audit-log" class="space-y-4">
  <h3 class="text-lg font-semibold text-gray-800">
    <!-- mdi: history -->
    <i class="mdi mdi-history mr-2"></i>
    <%= t('.audit_log_title') %>
  </h3>

  <% if versions.any? %>
    <div class="space-y-3">
      <% versions.each do |version| %>
        <div class="card-ui">
          <div class="p-4">
            <%# Заголовок события %>
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <i class="<%= event_icon(version.event) %> text-xl"></i>
                <%= render Ui::BadgeComponent.new(color: :gray, size: :sm) do %>
                  <%= event_text(version.event) %>
                <% end %>
              </div>
              <span class="text-xs text-gray-500" title="<%= render Ui::DateComponent.new(version.created_at, format: :long) %>">
                <%= time_ago_in_words(version.created_at) %> ago
              </span>
            </div>

            <%# Diff изменений %>
            <% if changes_present?(version) %>
              <div class="overflow-x-auto">
                <table class="min-w-full text-xs">
                  <thead>
                    <tr class="text-xs text-gray-500">
                      <th class="text-left pr-4 py-1"><%= t('.audit_field') %></th>
                      <th class="text-left pr-4 py-1"><%= t('.audit_old_value') %></th>
                      <th class="text-left py-1"><%= t('.audit_new_value') %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% changes_diff(version).each do |change| %>
                      <tr class="border-t border-gray-100">
                        <td class="font-medium text-gray-700 pr-4 py-1">
                          <%= change[:field] %>
                        </td>
                        <td class="text-error line-through pr-4 py-1">
                          <%= change[:old] %>
                        </td>
                        <td class="text-success font-medium py-1">
                          <%= change[:new] %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <p class="text-sm text-gray-500 italic">
                <%= t('.no_details') %>
              </p>
            <% end %>

            <%# Кто совершил действие %>
            <div class="mt-2 text-xs text-gray-400 flex items-center gap-1">
              <!-- mdi: account-circle -->
              <i class="mdi mdi-account-circle"></i>
              <%= whodunnit_name(version) %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card-ui">
      <div class="p-6 text-center">
        <!-- mdi: inbox-outline -->
        <i class="mdi mdi-inbox-outline text-4xl text-gray-300 mb-2"></i>
        <p class="text-gray-500">
          <%= t('.no_audit_logs') %>
        </p>
      </div>
    </div>
  <% end %>

  <%# Пагинация %>
  <%= render Ui::PaginationComponent.new(pagy: pagy) if pagy&.pages.to_i > 1 %>
</div>
