<%# frozen_string_literal: true %>

<%#
# app/components/admin/users/user/activity_component.html.erb - активность пользователя
#
# Отображает активность пользователя из Merit в виде таймлайна:
# - бейджи (mdi-trophy)
# - очки (mdi-star)
# - действия (mdi-check-circle)
# %>

<%= render Ui::CardComponent.new do |card| %>
  <% card.with_body do %>
    <h3 class="text-lg font-semibold text-gray-800 mb-4">
      <!-- mdi: history -->
      <i class="mdi mdi-history mr-1"></i>
      <%= t('.activity_title') %>
    </h3>

    <% if activities? %>
      <ul class="space-y-4">
        <% activities.each do |event| %>
          <li class="flex items-start gap-3">
            <div class="flex-shrink-0 mt-1">
              <div class="h-8 w-8 rounded-full bg-secondary/10 flex items-center justify-center">
                <i class="mdi <%= event.icon %> <%= event.color %> text-lg"></i>
              </div>
            </div>
            <div class="flex-1 bg-gray-50 rounded-xl p-4 border border-gray-100">
              <div class="flex items-center gap-2 mb-1">
                <%= render Ui::BadgeComponent.new(color: badge_color(event.type), size: :sm) do %>
                  <%= event_title(event) %>
                <% end %>
                <span class="text-xs text-gray-400">
                  <%= render Ui::DateComponent.new(event.created_at, format: :long) %>
                </span>
              </div>
              <div class="text-sm text-gray-600">
                <%= event.description %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="text-center py-8 text-gray-400">
        <!-- mdi: history-off -->
        <i class="mdi mdi-history-off text-4xl mb-2"></i>
        <p><%= t('.no_activity') %></p>
      </div>
    <% end %>
  <% end %>
<% end %>
