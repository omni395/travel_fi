<%# frozen_string_literal: true %>

<%#
# app/components/admin/users/user/wallet_component.html.erb - кошелек пользователя
#
# Заглушка для отображения информации о кошельке пользователя.
# %>

<%= render Ui::CardComponent.new do |card| %>
  <% card.with_body do %>
    <h3 class="text-lg font-semibold text-gray-800 mb-4">
      <!-- mdi: wallet -->
      <i class="mdi mdi-wallet mr-1"></i>
      <%= t('.wallet_title') %>
    </h3>

    <div class="text-center py-8 text-gray-400">
      <!-- mdi: wallet-outline -->
      <i class="mdi mdi-wallet-outline text-4xl mb-2"></i>
      <p><%= t('.wallet_placeholder') %></p>
    </div>
  <% end %>
<% end %>
