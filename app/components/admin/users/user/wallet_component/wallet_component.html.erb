<%# frozen_string_literal: true %>

<%#
# Admin::Users::User::WalletComponent — вкладка кошелька пользователя в админке.
# Иконки: mdi-coins, mdi-account-arrow-right, mdi-account-multiple, mdi-swap-horizontal
# %>

<div data-controller="admin--users--user--wallet-component" class="wallet-component">
  <%= render Ui::CardComponent.new do |card| %>
    <% card.with_body do %>
      <%# Баланс токенов %>
      <div class="mb-6 p-4 bg-gradient-to-r from-emerald-50 to-teal-50 rounded-lg border border-emerald-200">
        <p class="text-xs font-semibold text-gray-700 mb-1">
          <%# Иконка: mdi-coins %>
          <i class="mdi mdi-coins text-emerald-600 mr-1"></i>
          <%= t(".token_balance") %>
        </p>
        <p class="text-xl font-bold text-emerald-700">
          <%= t(".tft_balance", balance: format_amount(user.token_balance)) %>
        </p>
      </div>

      <%# Реферальная информация %>
      <div class="mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
        <p class="text-xs font-semibold text-gray-700 mb-2">
          <%# Иконка: mdi-account-arrow-right %>
          <i class="mdi mdi-account-arrow-right text-gray-600 mr-1"></i>
          <%= t(".referred_by") %>
        </p>
        <p class="text-sm text-gray-600">
          <% if user.referred_by.present? %>
            <%= link_to user.referred_by.name, admin_user_path(id: user.referred_by), class: "text-secondary hover:underline" %>
          <% else %>
            <span class="text-gray-400">—</span>
          <% end %>
        </p>
        <p class="text-xs text-gray-600 mt-3">
          <%# Иконка: mdi-account-multiple %>
          <i class="mdi mdi-account-multiple text-gray-600 mr-1"></i>
          <%= t(".referrals_count", count: user.referrals_count) %>
        </p>
      </div>

      <%# История транзакций %>
      <div class="mt-6">
        <h4 class="text-sm font-semibold text-gray-800 mb-3">
          <%# Иконка: mdi-swap-horizontal %>
          <i class="mdi mdi-swap-horizontal text-gray-600 mr-1"></i>
          <%= t(".transactions_title") %>
        </h4>

        <% if transactions.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t(".date") %></th>
                  <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t(".action") %></th>
                  <th scope="col" class="px-3 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t(".amount") %></th>
                  <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t(".status") %></th>
                  <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t(".tx_hash") %></th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% transactions.each do |tx| %>
                  <tr>
                    <td class="px-3 py-2 text-sm text-gray-600 whitespace-nowrap"><%= l(tx.created_at, format: :long) %></td>
                    <td class="px-3 py-2 text-sm text-gray-800">
                      <%= action_key_label(tx) %>
                      <span class="text-xs text-gray-400">(<%= direction_label(tx) %>)</span>
                    </td>
                    <td class="px-3 py-2 text-sm font-medium text-emerald-700 text-right whitespace-nowrap">
                      +<%= format_amount(tx.amount) %> TFT
                    </td>
                    <td class="px-3 py-2 text-sm">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class(tx) %>">
                        <%= status_label(tx) %>
                      </span>
                    </td>
                    <td class="px-3 py-2 text-sm whitespace-nowrap">
                      <% if tx.explorer_url.present? %>
                        <%= link_to tx.short_hash, tx.explorer_url, target: "_blank", rel: "noopener", class: "text-secondary hover:underline font-mono" %>
                      <% else %>
                        <span class="text-gray-400">—</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-sm text-gray-400"><%= t(".empty_transactions") %></p>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
