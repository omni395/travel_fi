<div class="h-full flex flex-col justify-between overflow-x-hidden pt-4">
  <nav class="flex-1">
    <ul class="flex flex-col space-y-1">
      <%# Ссылка Dashboard %>
      <li>
        <%= link_to admin_root_path(locale: I18n.locale), 
                    class: "flex items-center h-12 text-white hover:bg-white/10 transition-all duration-200 group/link" do %>
          <div class="flex items-center justify-center w-16 h-12 shrink-0">
            <i class="mdi mdi-view-dashboard text-2xl"></i>
          </div>
          <span class="font-medium text-sm whitespace-nowrap overflow-hidden transition-all duration-300
                       <%= @is_mobile ? 'opacity-100 max-w-xs ml-2' : 'opacity-0 max-w-0 group-hover:opacity-100 group-hover:max-w-xs group-hover:ml-2' %>">
            <%= t('admin.sidebar.dashboard') %>
          </span>
        <% end %>
      </li>

      <%# Ссылка Users %>
      <li>
        <%= link_to admin_users_path(locale: I18n.locale), 
                    class: "flex items-center h-12 text-white hover:bg-white/10 transition-all duration-200 group/link" do %>
          <div class="flex items-center justify-center w-16 h-12 shrink-0">
            <i class="mdi mdi-account-multiple text-2xl"></i>
          </div>
          <span class="font-medium text-sm whitespace-nowrap overflow-hidden transition-all duration-300
                       <%= @is_mobile ? 'opacity-100 max-w-xs ml-2' : 'opacity-0 max-w-0 group-hover:opacity-100 group-hover:max-w-xs group-hover:ml-2' %>">
            <%= t('admin.sidebar.users') %>
          </span>
        <% end %>
      </li>
    </ul>
  </nav>

  <div class="pb-4 border-t border-white/10 pt-2">
    <%= link_to root_path(locale: I18n.locale), class: "flex items-center h-12 text-white hover:bg-white/10" do %>
      <div class="flex items-center justify-center w-16 h-12 shrink-0">
        <i class="mdi mdi-home text-2xl"></i>
      </div>
      <span class="font-medium text-sm whitespace-nowrap overflow-hidden transition-all duration-300
                   <%= @is_mobile ? 'opacity-100 max-w-xs ml-2' : 'opacity-0 max-w-0 group-hover:opacity-100 group-hover:max-w-xs group-hover:ml-2' %>">
        <%= t('admin.sidebar.back_to_site') %>
      </span>
    <% end %>
  </div>
</div>