<%# Admin::Poi::TableComponent - таблица POI %>
<div data-admin-pois-list>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".name") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".category") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".city") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".author") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".status") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".rating") %>
          </th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".actions") %>
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% pois.each do |poi| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-gray-900"><%= poi.name %></div>
              <% if poi.osm_id.present? %>
                <div class="text-xs text-gray-400">OSM: <%= poi.osm_id %></div>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= poi.poi_category.localized_name %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= poi.city || "-" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= poi.user.name %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_badge_class(poi.status) %>">
                <%= t("pois.status.#{poi.status}") %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <% if poi.rating > 0 %>
                <div class="flex items-center gap-1">
                  <i class="mdi mdi-star text-yellow-400 text-sm"></i>
                  <%# Иконка: mdi-star %>
                  <%= poi.rating %>
                </div>
              <% else %>
                -
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to admin_poi_path(poi), class: "text-emerald-600 hover:text-emerald-800" do %>
                <i class="mdi mdi-eye"></i>
                <%# Иконка: mdi-eye %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if pagy %>
    <div class="px-6 py-4 border-t border-gray-200">
      <%== pagy_nav(pagy) if pagy.pages > 1 %>
    </div>
  <% end %>
</div>
