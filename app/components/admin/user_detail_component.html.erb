<%# frozen_string_literal: true %>

<%#
# app/components/admin/user_detail_component.html.erb - детальный вид пользователя
#
# Отображает:
# - Детальную информацию о пользователе
# - Историю изменений (версии)
# - Кнопки действий
# %>

<div class="card bg-base-100 shadow-xl mb-6" data-admin-user-detail>
  <div class="card-body">
    <div class="flex items-start justify-between mb-6">
      <div class="flex items-center">
        <div class="avatar">
          <div class="w-24 rounded-full">
            <% if user.avatar.attached? %>
              <%= image_tag user.avatar.variant(resize: '100x100'),
                    class: 'w-full h-full object-cover' %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center bg-gray-300">
                <i class="mdi mdi-account text-4xl text-gray-600"></i>
              </div>
            <% end %>
          </div>
        </div>
        <div class="ml-6">
          <h1 class="text-2xl font-bold text-gray-900">
            <%= user.name %>
          </h1>
          <p class="text-gray-600">
            <%= user.email %>
          </p>
          <div class="mt-2">
            <div class="badge <%= status_badge_class %>">
              <%= status_text %>
            </div>
          </div>
        </div>
      </div>

      <%# Кнопки действий %>
      <div class="flex flex-col gap-2">
        <button data-action="click->admin-users#startEdit"
                data-user-id="<%= user.id %>"
                class="btn btn-primary">
          <%= t('admin.users.edit') %>
        </button>

        <%# Кнопки управления статусом %>
        <% case user.status %>
        <% when 'pending_verification' %>
          <button data-action="click->admin-users#updateStatus"
                  data-status="active"
                  data-user-id="<%= user.id %>"
                  class="btn btn-success">
            <%= t('admin.users.activate') %>
          </button>
        <% when 'active' %>
          <button data-action="click->admin-users#updateStatus"
                  data-status="suspended"
                  data-user-id="<%= user.id %>"
                  class="btn btn-warning">
            <%= t('admin.users.suspend') %>
          </button>
        <% when 'suspended' %>
          <button data-action="click->admin-users#updateStatus"
                  data-status="banned"
                  data-user-id="<%= user.id %>"
                  class="btn btn-error">
            <%= t('admin.users.ban') %>
          </button>
        <% when 'banned' %>
          <button data-action="click->admin-users#updateStatus"
                  data-status="active"
                  data-user-id="<%= user.id %>"
                  class="btn btn-info">
            <%= t('admin.users.restore') %>
          </button>
        <% end %>

        <button data-action="click->admin-users#destroyUser"
                data-user-id="<%= user.id %>"
                class="btn btn-error">
          <%= t('admin.users.destroy') %>
        </button>
      </div>
    </div>

    <%# Детальная информация %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h3 class="card-title text-lg font-semibold text-gray-800 mb-3">
            <%= t('admin.users.profile_info') %>
          </h3>
          <div class="space-y-2">
            <div class="flex justify-between">
              <span class="text-sm font-medium text-gray-500">
                <%= t('admin.users.created_at') %>
              </span>
              <span class="text-sm text-gray-900">
                <%= format_date(user.created_at) %>
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-sm font-medium text-gray-500">
                <%= t('admin.users.updated_at') %>
              </span>
              <span class="text-sm text-gray-900">
                <%= format_date(user.updated_at) %>
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-sm font-medium text-gray-500">
                <%= t('admin.users.last_sign_in_at') %>
              </span>
              <span class="text-sm text-gray-900">
                <%= format_date(user.last_sign_in_at) %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h3 class="card-title text-lg font-semibold text-gray-800 mb-3">
            <%= t('admin.users.roles') %>
          </h3>
          <div class="flex flex-wrap gap-2">
            <% user.roles.each do |role| %>
              <div class="badge badge-primary">
                <%= role.name %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%# История изменений %>
<% if versions.present? %>
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h3 class="card-title text-lg font-semibold text-gray-800 mb-4">
        <%= t('admin.users.history') %>
      </h3>
      <ul class="timeline timeline-vertical">
        <% versions.each do |version| %>
          <li>
            <div class="timeline-middle">
              <i class="mdi mdi-history text-teal-500 text-xl"></i>
            </div>
            <div class="timeline-end timeline-box">
              <div class="text-sm text-gray-600">
                <%= version.event %> <%= t('admin.users.by') %> <%= version.whodunnit %>
              </div>
              <div class="text-xs text-gray-500">
                <%= l(version.created_at, format: :short) %>
              </div>
            </div>
            <hr/>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
