<%# frozen_string_literal: true %>

<%#
# app/components/admin/users_list_component.html.erb - список пользователей
#
# Отображает:
# - Список пользователей с фильтрами
# - Детальный вид пользователя
# - Форму редактирования пользователя
# Использует StimulusReflex для обновления без перезагрузки
# %>

<div class="p-6" data-controller="admin-users">
  <%# Заголовок страницы %>
  <h1 class="text-3xl font-bold text-teal-600 mb-6">
    <%= t('admin.users.index.title') %>
  </h1>

  <%# Фильтры и поиск %>
  <div class="card bg-base-100 shadow-xl mb-6">
    <div class="card-body">
      <div class="flex flex-wrap gap-4">
        <%# Поиск %>
        <div class="flex-1 min-w-[200px]">
          <input type="text"
                 name="q"
                 value="<%= @search_query %>"
                 placeholder="<%= t('admin.users.search_placeholder') %>"
                 data-action="input->admin-users#search"
                 class="input input-bordered w-full">
        </div>

        <%# Фильтр по статусу %>
        <div class="w-full md:w-auto">
          <select name="status"
                  data-action="change->admin-users#filterByStatus"
                  class="select select-bordered w-full md:w-48">
            <option value="">
              <%= t('admin.users.all_statuses') %>
            </option>
            <option value="active" <%= 'selected' if @status_filter == 'active' %>>
              <%= t('activerecord.attributes.user.statuses.active') %>
            </option>
            <option value="suspended" <%= 'selected' if @status_filter == 'suspended' %>>
              <%= t('activerecord.attributes.user.statuses.suspended') %>
            </option>
            <option value="banned" <%= 'selected' if @status_filter == 'banned' %>>
              <%= t('activerecord.attributes.user.statuses.banned') %>
            </option>
            <option value="pending_verification" <%= 'selected' if @status_filter == 'pending_verification' %>>
              <%= t('activerecord.attributes.user.statuses.pending_verification') %>
            </option>
          </select>
        </div>

        <%# Сброс фильтров %>
        <div>
          <button data-action="admin-users#resetFilters"
                  class="btn btn-ghost">
            <%= t('admin.users.reset') %>
          </button>
        </div>
      </div>
    </div>
  </div>

  <%# Если выбран пользователь - показываем детальный вид или форму редактирования %>
  <% if user_selected? %>
    <div id="user-detail" data-user-id="<%= @selected_user.id %>">
      <% if edit_mode? %>
        <%# Форма редактирования %>
        <div class="card bg-base-100 shadow-xl mb-6">
          <div class="card-body">
            <div class="flex items-center justify-between mb-6">
              <h2 class="card-title text-2xl font-bold text-gray-900">
                <%= t('admin.users.edit_title', name: @selected_user.name) %>
              </h2>
              <button data-action="admin-users#cancelEdit"
                      class="btn btn-ghost">
                <%= t('admin.users.cancel') %>
              </button>
            </div>

            <div class="space-y-6">
              <%# Имя %>
              <div class="form-control">
                <label class="label">
                  <span class="label-text"><%= t('admin.users.name') %></span>
                </label>
                <input type="text"
                       id="user_name"
                       name="name"
                       value="<%= @selected_user.name %>"
                       data-action="change->admin-users#updateField"
                       data-field="name"
                       class="input input-bordered w-full">
              </div>

              <%# Email %>
              <div class="form-control">
                <label class="label">
                  <span class="label-text"><%= t('admin.users.email') %></span>
                </label>
                <input type="email"
                       id="user_email"
                       name="email"
                       value="<%= @selected_user.email %>"
                       data-action="change->admin-users#updateField"
                       data-field="email"
                       class="input input-bordered w-full">
              </div>

              <%# Статус %>
              <div class="form-control">
                <label class="label">
                  <span class="label-text"><%= t('admin.users.status') %></span>
                </label>
                <select id="user_status"
                        name="status"
                        data-action="change->admin-users#updateField"
                        data-field="status"
                        class="select select-bordered w-full">
                  <option value="active" <%= 'selected' if @selected_user.status == 'active' %>>
                    <%= t('activerecord.attributes.user.statuses.active') %>
                  </option>
                  <option value="suspended" <%= 'selected' if @selected_user.status == 'suspended' %>>
                    <%= t('activerecord.attributes.user.statuses.suspended') %>
                  </option>
                  <option value="banned" <%= 'selected' if @selected_user.status == 'banned' %>>
                    <%= t('activerecord.attributes.user.statuses.banned') %>
                  </option>
                  <option value="pending_verification" <%= 'selected' if @selected_user.status == 'pending_verification' %>>
                    <%= t('activerecord.attributes.user.statuses.pending_verification') %>
                  </option>
                </select>
              </div>

              <%# Кнопки действий %>
              <div class="flex gap-4">
                <button data-action="click->admin-users#save"
                        class="btn btn-primary">
                  <%= t('admin.users.save') %>
                </button>
              </div>
            </div>
          </div>
        </div>

        <%# Управление ролями %>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-xl font-semibold text-gray-800 mb-4">
              <%= t('admin.users.manage_roles') %>
            </h2>

            <div class="space-y-2">
              <% @roles.each do |role| %>
                <div class="flex items-center justify-between p-3 border rounded-lg">
                  <div>
                    <span class="font-medium text-gray-900">
                      <%= role.name %>
                    </span>
                    <span class="ml-2 text-sm text-gray-500">
                      <%= t("admin.roles.#{role.name}") %>
                    </span>
                  </div>

                  <% if @selected_user.has_role?(role.name) %>
                    <button data-action="click->admin-users#removeRole"
                            data-role-id="<%= role.id %>"
                            class="btn btn-sm btn-error">
                      <%= t('admin.users.remove_role') %>
                    </button>
                  <% else %>
                    <button data-action="click->admin-users#addRole"
                            data-role-id="<%= role.id %>"
                            class="btn btn-sm btn-success">
                      <%= t('admin.users.add_role') %>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <%# Детальный вид пользователя %>
        <div class="card bg-base-100 shadow-xl mb-6">
          <div class="card-body">
            <div class="flex items-start justify-between mb-6">
              <div class="flex items-center">
                <div class="avatar">
                  <div class="w-24 rounded-full">
                    <% if @selected_user.avatar.attached? %>
                      <%= image_tag @selected_user.avatar.variant(resize: '100x100'),
                            class: 'w-full h-full object-cover' %>
                    <% else %>
                      <div class="w-full h-full flex items-center justify-center bg-gray-300">
                        <i class="mdi mdi-account text-4xl text-gray-600"></i>
                      </div>
                    <% end %>
                  </div>
                </div>
                <div class="ml-6">
                  <h1 class="text-2xl font-bold text-gray-900">
                    <%= @selected_user.name %>
                  </h1>
                  <p class="text-gray-600">
                    <%= @selected_user.email %>
                  </p>
                  <div class="mt-2">
                    <div class="badge <%= status_badge_class(@selected_user.status) %>">
                      <%= t("activerecord.attributes.user.statuses.#{@selected_user.status}") %>
                    </div>
                  </div>
                </div>
              </div>

              <%# Кнопки действий %>
              <div class="flex flex-col gap-2">
                <button data-action="click->admin-users#startEdit"
                        class="btn btn-primary">
                  <%= t('admin.users.edit') %>
                </button>

              <%# Кнопки управления статусом %>
              <% case @selected_user.status %>
              <% when 'pending_verification' %>
                <button data-action="click->admin-users#updateStatus"
                        data-status="active"
                        class="btn btn-success">
                  <%= t('admin.users.activate') %>
                </button>
              <% when 'active' %>
                <button data-action="click->admin-users#updateStatus"
                        data-status="suspended"
                        class="btn btn-warning">
                  <%= t('admin.users.suspend') %>
                </button>
              <% when 'suspended' %>
                <button data-action="click->admin-users#updateStatus"
                        data-status="banned"
                        class="btn btn-error">
                  <%= t('admin.users.ban') %>
                </button>
              <% when 'banned' %>
                <button data-action="click->admin-users#updateStatus"
                        data-status="active"
                        class="btn btn-info">
                  <%= t('admin.users.restore') %>
                </button>
              <% end %>

              <button data-action="click->admin-users#destroyUser"
                      class="btn btn-error">
                <%= t('admin.users.destroy') %>
              </button>
            </div>
          </div>

          <%# Детальная информация %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h3 class="text-lg font-semibold text-gray-800 mb-3">
                <%= t('admin.users.profile_info') %>
              </h3>
              <dl class="space-y-2">
                <div class="flex justify-between">
                  <dt class="text-sm font-medium text-gray-500">
                    <%= t('admin.users.created_at') %>
                  </dt>
                  <dd class="text-sm text-gray-900">
                    <%= l(@selected_user.created_at, format: :long) %>
                  </dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-sm font-medium text-gray-500">
                    <%= t('admin.users.updated_at') %>
                  </dt>
                  <dd class="text-sm text-gray-900">
                    <%= l(@selected_user.updated_at, format: :long) %>
                  </dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-sm font-medium text-gray-500">
                    <%= t('admin.users.last_sign_in_at') %>
                  </dt>
                  <dd class="text-sm text-gray-900">
                    <%= @selected_user.last_sign_in_at ? l(@selected_user.last_sign_in_at, format: :long) : t('admin.users.never') %>
                  </dd>
                </div>
              </dl>
            </div>

            <div>
              <h3 class="text-lg font-semibold text-gray-800 mb-3">
                <%= t('admin.users.roles') %>
              </h3>
              <div class="flex flex-wrap gap-2">
                <% @selected_user.roles.each do |role| %>
                  <span class="px-3 py-1 text-sm font-medium rounded bg-teal-100 text-teal-800">
                    <%= role.name %>
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Таблица пользователей %>
  <div class="bg-white rounded-lg shadow-md overflow-hidden" data-admin-users-list>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= t('admin.users.name') %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= t('admin.users.email') %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= t('admin.users.status') %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= t('admin.users.roles') %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= t('admin.users.created_at') %>
            </th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= t('admin.users.actions') %>
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @users.each do |user| %>
            <tr class="hover:bg-gray-50 cursor-pointer"
                data-action="click->admin-users#selectUser"
                data-user-id="<%= user.id %>">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <% if user.avatar.attached? %>
                    <%= image_tag user.avatar.variant(resize: '40x40'),
                          class: 'h-10 w-10 rounded-full' %>
                  <% else %>
                    <div class="h-10 w-10 rounded-full bg-gray-300 flex items-center justify-center">
                      <span class="mdi mdi-account text-gray-600"></span>
                      <%# MDI: account %>
                    </div>
                  <% end %>
                  <div class="ml-4">
                    <div class="text-sm font-medium text-gray-900">
                      <%= user.name %>
                    </div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= user.email %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                      <%= status_badge_class(user.status) %>">
                  <%= t("activerecord.attributes.user.statuses.#{user.status}") %>
                </span>
              </td>
              <td>
                <div class="flex flex-wrap gap-1">
                  <% user.roles.each do |role| %>
                    <div class="badge badge-sm badge-primary">
                      <%= role.name %>
                    </div>
                  <% end %>
                </div>
              </td>
              <td><%= l(user.created_at, format: :short) %></td>
              <td>
                <button data-action="click->admin-users#selectUser"
                        data-user-id="<%= user.id %>"
                        class="btn btn-ghost btn-sm">
                  <%= t('admin.users.view') %>
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# Пагинация %>
    <div class="join justify-center mt-4">
      <%= paginate @users, theme: 'bootstrap-5' %>
    </div>
  </div>
</div>
