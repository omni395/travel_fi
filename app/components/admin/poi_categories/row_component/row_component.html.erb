<%# frozen_string_literal: true %>
<%#
# Admin::PoiCategories::RowComponent - строка таблицы категорий POI
# Колонки: ID | Icon | Name | POIs | Status(MDI+tooltip)
# %>
<tr class="hover:bg-gray-50 cursor-pointer"
      data-action="click->admin--poi-categories--table-component#visitCategory"
      data-admin-poi-category-id="<%= category.to_param %>">
    <%# ID %>
    <td class="px-2 py-1.5 whitespace-nowrap text-xs text-gray-400 font-mono">
      <%= category.id %>
    </td>
    <%# Icon (картинка-маркер, fallback — MDI-иконка категории) %>
    <td class="px-2 py-1.5 whitespace-nowrap text-center">
      <% if category.category_icon_url.present? %>
        <img src="<%= category.category_icon_url %>"
             alt="<%= t('.icon_alt') %>"
             class="w-6 h-6 object-cover rounded inline-block">
      <% elsif category.icon.present? %>
        <i class="mdi <%= category.icon %> text-emerald-500 text-lg"></i>
        <%# Иконка: динамическая из category.icon (fallback) %>
      <% end %>
    </td>
    <%# Name %>
    <td class="px-2 py-1.5 whitespace-nowrap">
      <div class="text-xs font-medium text-gray-900"><%= category.localized_name %></div>
    </td>
    <%# POIs count %>
    <td class="px-2 py-1.5 whitespace-nowrap text-xs text-gray-500 text-center">
      <%= category.pois.count %>
    </td>
    <%# Status (MDI + title tooltip) %>
    <td class="px-2 py-1.5 whitespace-nowrap text-center">
      <% if category.active %>
        <i class="mdi mdi-check-circle text-emerald-500 text-lg" title="<%= t('.active') %>"></i>
        <%# Иконка: mdi-check-circle %>
      <% else %>
        <i class="mdi mdi-close-circle text-gray-300 text-lg" title="<%= t('.inactive') %>"></i>
        <%# Иконка: mdi-close-circle %>
      <% end %>
    </td>
</tr>
