<%# Admin::PoiCategories::TableComponent - таблица категорий POI %>
<%# Колонки: ID | Icon | Name | POIs | Status %>
<div data-admin-poi-categories-list>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-2 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider w-12">
            ID
          </th>
          <th scope="col" class="px-2 py-3 text-center text-xs font-medium text-gray-400 uppercase tracking-wider w-10">
            <!-- Icon -->
          </th>
          <th scope="col" class="px-2 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".name") %>
          </th>
          <th scope="col" class="px-2 py-3 text-center text-xs font-medium text-gray-400 uppercase tracking-wider w-16">
            <%= t(".pois") %>
          </th>
          <th scope="col" class="px-2 py-3 text-center text-xs font-medium text-gray-400 uppercase tracking-wider w-12">
            <%= t(".status") %>
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% categories.each do |category| %>
          <%= render Admin::PoiCategories::RowComponent.new(category: category) %>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if pagy && pagy.pages > 1 %>
    <div class="px-6 py-4 border-t border-gray-200">
      <%= render ::Ui::PaginationComponent.new(pagy: pagy, pagination_controller: "admin--poi-categories--table-component") %>
    </div>
  <% end %>
</div>
