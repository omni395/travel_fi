<%# Admin::PoiCategories::TableComponent - таблица категорий POI %>
<div data-admin-poi-categories-list>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".position") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".icon") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".name") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".slug") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".fields_count") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".status") %>
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% categories.each do |category| %>
          <%= render Admin::PoiCategories::RowComponent.new(category: category) %>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if pagy && pagy.pages > 1 %>
    <div class="px-6 py-4 border-t border-gray-200">
      <%= render ::Ui::PaginationComponent.new(pagy: pagy, pagination_controller: "admin--poi-categories--table-component") %>
    </div>
  <% end %>
</div>
