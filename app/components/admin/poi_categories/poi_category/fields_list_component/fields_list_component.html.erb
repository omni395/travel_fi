<%# Admin::PoiCategories::PoiCategory::FieldsListComponent - список полей категории POI + форма создания %>
<%# Контейнер [data-poi-category-fields] вынесен в обёртку show.html.erb,
    чтобы inner_html от Broadcaster не создавал вложенность (см. CableReady). %>
<div data-controller="admin--poi-categories--poi-category--fields-list-component">
  <div class="bg-white shadow rounded-lg p-6 mt-6">
    <div class="flex items-center justify-between mb-2">
      <h2 class="text-lg font-semibold text-gray-900">
        <%# MDI: format-list-bulleted %>
        <i class="mdi mdi-format-list-bulleted text-emerald-500 mr-2"></i>
        <%= t(".fields_title") %>
      </h2>
      <%= render Ui::BtnComponent.new(color: :primary, size: :sm, html: { data: { action: "click->admin--poi-categories--poi-category--fields-list-component#openForm" } }) do %>
        <%# MDI: plus-circle %>
        <i class="mdi mdi-plus-circle mr-1"></i>
        <%= t(".add_field") %>
      <% end %>
    </div>
    <p class="text-sm text-gray-500 mb-4">
      <%# MDI: information-outline %>
      <i class="mdi mdi-information-outline mr-1"></i>
      <%= t(".fields_hint") %>
    </p>

    <% if fields.any? %>
      <div class="overflow-x-auto mb-6">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase w-16"></th>
              <th scope="col" class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase w-12"><%= t(".position") %></th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t(".field_key") %></th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t(".label") %></th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t(".field_type") %></th>
              <th scope="col" class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase"><%= t(".required") %></th>
              <th scope="col" class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase"><%= t(".active") %></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% fields.each_with_index do |field, idx| %>
              <% is_first = idx.zero? %>
              <% is_last = last_field?(field) %>
              <tr class="hover:bg-gray-50 cursor-pointer"
                  data-action="click->admin--poi-categories--poi-category--fields-list-component#editField"
                  data-field-id="<%= field.id %>"
                  data-field-json="<%= {
                    id: field.id,
                    field_key: field.field_key,
                    field_type: field.field_type,
                    position: field.position,
                    required: field.required,
                    active: field.active,
                    label: field.label,
                    placeholder: field.placeholder,
                    hint: field.hint,
                    options: field.options,
                    poi_category_id: field.poi_category_id
                  }.to_json %>">
                <%# Reorder (первая колонка) %>
                <td class="px-2 py-3 text-sm text-center whitespace-nowrap">
                  <button type="button"
                          data-action="click->admin--poi-categories--poi-category--fields-list-component#moveUp"
                          data-field-id="<%= field.id %>"
                          class="inline-flex items-center justify-center p-0.5 transition-colors <%= is_first ? 'text-gray-300 cursor-not-allowed' : 'text-gray-500 hover:text-emerald-600' %>"
                    <% if is_first %> disabled <% end %>>
                    <%# MDI: arrow-up-bold %>
                    <i class="mdi mdi-arrow-up-bold text-lg"></i>
                  </button>
                  <button type="button"
                          data-action="click->admin--poi-categories--poi-category--fields-list-component#moveDown"
                          data-field-id="<%= field.id %>"
                          class="inline-flex items-center justify-center p-0.5 transition-colors <%= is_last ? 'text-gray-300 cursor-not-allowed' : 'text-gray-500 hover:text-emerald-600' %>"
                    <% if is_last %> disabled <% end %>>
                    <%# MDI: arrow-down-bold %>
                    <i class="mdi mdi-arrow-down-bold text-lg"></i>
                  </button>
                </td>
                <%# Position %>
                <td class="px-2 py-3 text-sm text-center text-gray-500"><%= field.position %></td>
                <%# Key %>
                <td class="px-4 py-3 text-sm">
                  <code class="bg-gray-100 px-2 py-0.5 rounded"><%= field.field_key %></code>
                </td>
                <%# Label %>
                <td class="px-4 py-3 text-sm text-gray-900"><%= field.localized_label %></td>
                <%# Type %>
                <td class="px-4 py-3 text-sm">
                  <span class="px-2 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-teal-100 text-teal-800">
                    <%= field.field_type %>
                  </span>
                </td>
                <%# Required %>
                <td class="px-4 py-3 text-sm text-center">
                  <% if field.required %>
                    <i class="mdi mdi-check-circle text-green-500"></i>
                  <% else %>
                    <i class="mdi mdi-close-circle text-gray-300"></i>
                  <% end %>
                </td>
                <%# Active %>
                <td class="px-4 py-3 text-sm text-center">
                  <% if field.active %>
                    <i class="mdi mdi-check-circle text-green-500"></i>
                  <% else %>
                    <i class="mdi mdi-close-circle text-gray-300"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-8 text-gray-500">
        <%# MDI: information-outline %>
        <i class="mdi mdi-information-outline text-4xl mb-2"></i>
        <p><%= t(".no_fields") %></p>
      </div>
    <% end %>
  </div>
</div>

<%# Диалог создания поля %>
<%= render Admin::PoiCategories::PoiCategory::FieldFormComponent.new(category: category) %>
