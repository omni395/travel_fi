<%# Admin::PoiCategories::PoiCategory::ShowComponent - детальная страница категории POI %>
<%# Структура: Ui::CardComponent с header/body (как у Admin::Users::User::ShowComponent) %>
<div id="poi-category-detail"
     data-controller="admin--poi-categories--poi-category--show-component"
     data-admin-poi-category-id="<%= category.to_param %>">

  <%= render Ui::CardComponent.new do |card| %>
      <% card.with_body do %>
        <%# Алерт о незаполненных переводах %>
        <% if missing_translations? %>
          <div class="mb-4 p-3 rounded-lg bg-amber-50 border border-amber-200">
            <div class="flex items-center gap-2 text-amber-800 text-sm">
              <%# MDI: translate %>
              <i class="mdi mdi-translate text-lg"></i>
              <span><%= missing_translations_message %></span>
            </div>
          </div>
        <% end %>

        <%# Верхняя секция: иконка + информация + кнопки %>
        <div class="flex flex-col sm:flex-row items-start gap-6">
          <%# Иконка/картинка-маркер категории (картинка приоритетнее, fallback — MDI) %>
          <div class="shrink-0 w-16 h-16 bg-emerald-50 rounded-xl flex items-center justify-center overflow-hidden">
            <% if category.category_icon_url.present? %>
              <img src="<%= category.category_icon_url %>"
                   alt="<%= t('.icon_alt') %>"
                   class="w-full h-full object-cover">
            <% else %>
              <span class="text-emerald-500 text-3xl">
                <% if category.icon.present? %>

                  <i class="mdi <%= category.icon %>"></i>
                  <%# Иконка: динамическая из category.icon %>

                <% else %>

                  <i class="mdi mdi-map-marker"></i>
                  <%# Иконка: mdi-map-marker (дефолтная) %>

                <% end %>
              </span>
            <% end %>
          </div>

          <%# Название, slug, статус %>
          <div class="flex-1 min-w-0">
            <h1 class="text-2xl font-bold text-gray-900 truncate">
              <%= category.localized_name %>
            </h1>
            <p class="text-gray-500 font-medium">
              <code class="bg-gray-100 px-2 py-0.5 rounded text-sm"><%= category.slug %></code>
            </p>

            <div class="mt-3 flex flex-wrap items-center gap-3">
              <%# Статус %>
              <% if category.active %>
                <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                  <%= t(".active") %>
                </span>
              <% else %>
                <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                  <%= t(".inactive") %>
                </span>
              <% end %>
            </div>
          </div>

          <%# Кнопки действий %>
          <div class="flex flex-col gap-2 w-full sm:w-auto">
            <%# Редактировать %>
            <%= link_to admin_poi_category_path(id: category, edit: true),
                        class: "btn-ui btn-ui--primary btn-ui--md" do %>
              <!-- mdi: pencil -->
              <i class="mdi mdi-pencil"></i>
              <%= t(".edit") %>
            <% end %>
          </div>
        </div>

        <%# Разделитель %>
        <div class="divider-ui"></div>

        <%# Детальная информация %>
        <div class="space-y-2">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <span class="text-sm text-gray-400 flex items-center gap-1">
                <i class="mdi mdi-order-numeric-asc text-gray-400"></i>
                <%# Иконка: mdi-order-numeric-asc %>
                <span><%= t(".position") %>: <strong><%= category.position %></strong></span>
              </span>
            </div>
            <div>
              <span class="text-sm text-gray-400 flex items-center gap-1">
                <i class="mdi mdi-map-marker-multiple text-gray-400"></i>
                <%# Иконка: mdi-map-marker-multiple %>
                <span><%= t(".pois_count") %>: <strong><%= category.pois.count %></strong></span>
              </span>
            </div>
          </div>
        </div>

        <%# Диалог импорта из OSM %>
        <%= render Admin::PoiCategories::PoiCategory::OsmImportComponent.new(category: category) %>
      <% end %>
  <% end %>
</div>
