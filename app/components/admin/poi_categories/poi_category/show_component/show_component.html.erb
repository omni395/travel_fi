<%# Admin::PoiCategories::PoiCategory::ShowComponent - детальная страница категории POI %>
<div id="poi-category-detail" data-controller="admin--poi-categories--poi-category--show-component" data-admin-poi-category-id="<%= category.to_param %>">
  <div class="bg-white shadow rounded-lg p-6">
    <%# Алерт о незаполненных переводах %>
    <% if missing_translations? %>
      <div class="mb-4 p-3 rounded-lg bg-amber-50 border border-amber-200">
        <div class="flex items-center gap-2 text-amber-800 text-sm">
          <%# MDI: translate %>
          <i class="mdi mdi-translate text-lg"></i>
          <span><%= missing_translations_message %></span>
        </div>
      </div>
    <% end %>

    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <% if category.icon.present? %>
          <span class="text-emerald-500 text-3xl">
            <i class="mdi <%= category.icon %>"></i>
            <%# Иконка: динамическая из category.icon %>
          </span>
        <% else %>
          <span class="text-emerald-500 text-3xl">
            <i class="mdi mdi-map-marker"></i>
            <%# Иконка: mdi-map-marker (дефолтная) %>
          </span>
        <% end %>
        <div>
          <h1 class="text-2xl font-bold text-gray-900"><%= category.localized_name %></h1>
          <p class="text-sm text-gray-500">
            <code class="bg-gray-100 px-2 py-0.5 rounded"><%= category.slug %></code>
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <% if category.active %>
          <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-green-100 text-green-800">
            <%= t(".active") %>
          </span>
        <% else %>
          <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
            <%= t(".inactive") %>
          </span>
        <% end %>

        <%# Кнопка редактирования %>
        <%= link_to admin_poi_category_path(id: category, edit: true),
                    class: "btn-ui btn-ui--ghost btn-ui--sm" do %>
          <!-- mdi: pencil -->
          <i class="mdi mdi-pencil"></i>
          <%= t(".edit") %>
        <% end %>
      </div>
    </div>

    <% if category.description.present? %>
      <div class="mb-6">
        <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-2">
          <%= t(".description") %>
        </h3>
        <p class="text-gray-700"><%= category.localized_description %></p>
      </div>
    <% end %>

    <div class="border-t border-gray-200 pt-4">
      <dl class="grid grid-cols-2 gap-4">
        <div>
          <dt class="text-sm font-medium text-gray-500"><%= t(".position") %></dt>
          <dd class="mt-1 text-sm text-gray-900"><%= category.position %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500"><%= t(".pois_count") %></dt>
          <dd class="mt-1 text-sm text-gray-900"><%= category.pois.count %></dd>
        </div>
      </dl>
    </div>
  </div>
</div>
