<%# Admin::PoiCategories::PoiCategory::OsmImportComponent — диалог импорта из OSM %>
<%# Иконка: mdi-cloud-download %>
<div class="osm-import-component"
     data-controller="admin--poi-categories--poi-category--osm-import-component"
     data-admin--poi-categories--poi-category--osm-import-component-cities-value="<%= cities_data.to_json %>">

  <%# Затемнённый оверлей (скрыт по умолчанию) %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 hidden"
       data-admin--poi-categories--poi-category--osm-import-component-target="overlay">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md mx-4 p-6">
      <%# Заголовок %>
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-900">
          <!-- mdi: cloud-download -->
          <i class="mdi mdi-cloud-download text-emerald-500 mr-2"></i>
          <%= t(".title") %>
        </h3>
        <%= render Ui::BtnComponent.new(color: :ghost, size: :sm, html: { data: { action: "click->admin--poi-categories--poi-category--osm-import-component#close" } }) do %>
          <%# MDI: close %>
          <i class="mdi mdi-close text-xl"></i>
        <% end %>
      </div>

      <%# Предупреждение: OSM-теги не настроены %>
      <% unless can_import? %>
        <div class="mb-4 p-3 rounded-lg bg-amber-50 border border-amber-200">
          <div class="flex items-start gap-2 text-amber-800 text-sm">
            <%# MDI: alert-outline %>
            <i class="mdi mdi-alert-outline text-lg shrink-0 mt-0.5"></i>
            <span><%= t(".no_osm_tags_warning") %></span>
          </div>
        </div>
      <% end %>

      <%# --- Выбор локации (скрывается после старта импорта) --- %>
      <div data-admin--poi-categories--poi-category--osm-import-component-target="locationPanel">
        <%# Выбор города (Ui::DropdownComponent) %>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">
            <!-- mdi: city -->
            <i class="mdi mdi-city mr-1"></i>
            <%= t(".select_city") %>
          </label>
          <%= render Ui::DropdownComponent.new(position: "left", menu_classes: "w-full bg-white border border-gray-200") do |dropdown| %>
            <% dropdown.with_trigger do %>
              <button type="button"
                      data-action="ui--dropdown-component#toggle"
                      class="field-input w-full text-left flex items-center justify-between">
                <span data-admin--poi-categories--poi-category--osm-import-component-target="cityTriggerText"><%= t(".choose_city") %></span>
                <!-- mdi: chevron-down -->
                <i class="mdi mdi-chevron-down text-gray-400"></i>
              </button>
            <% end %>
            <% dropdown.with_menu do %>
              <div class="py-1 max-h-60 overflow-y-auto">
                <% cities_data.each do |name, data| %>
                  <button type="button"
                          class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700 transition-colors"
                          data-action="ui--dropdown-component#toggle click->admin--poi-categories--poi-category--osm-import-component#selectCity"
                          data-city="<%= name %>"
                          data-bbox="<%= data[:bbox].to_json %>"
                          data-country="<%= data[:country] %>">
                    <%= name %>, <%= data[:country] %>
                    <span class="text-gray-400 ml-1">(<%= data[:poi_count] %>)</span>
                  </button>
                <% end %>
              </div>
            <% end %>
          <% end %>
          <%# Ошибка валидации (скрыта) %>
          <p class="text-red-500 text-xs mt-1 hidden"
             data-admin--poi-categories--poi-category--osm-import-component-target="validationError"></p>
        </div>

        <%# Свой вариант (раскрывается) %>
        <div class="mb-4">
          <%= render Ui::BtnComponent.new(color: :ghost, size: :sm, html: { data: { action: "click->admin--poi-categories--poi-category--osm-import-component#toggleCustom" } }) do %>
            <%# MDI: plus-circle-outline %>
            <i class="mdi mdi-plus-circle-outline mr-1"></i>
            <%= t(".custom_location") %>
          <% end %>
        </div>

        <div class="hidden space-y-3 mb-4"
             data-admin--poi-categories--poi-category--osm-import-component-target="customFields">
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1"><%= t(".city_name") %></label>
            <input type="text"
                   data-admin--poi-categories--poi-category--osm-import-component-target="customCity"
                   class="field-input w-full"
                   autocomplete="off">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1"><%= t(".country") %></label>
            <input type="text"
                   data-admin--poi-categories--poi-category--osm-import-component-target="customCountry"
                   class="field-input w-full"
                   autocomplete="off">
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">South</label>
              <input type="number" step="0.01"
                     data-admin--poi-categories--poi-category--osm-import-component-target="customSouth"
                     class="field-input w-full"
                     autocomplete="off">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">West</label>
              <input type="number" step="0.01"
                     data-admin--poi-categories--poi-category--osm-import-component-target="customWest"
                     class="field-input w-full"
                     autocomplete="off">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">North</label>
              <input type="number" step="0.01"
                     data-admin--poi-categories--poi-category--osm-import-component-target="customNorth"
                     class="field-input w-full"
                     autocomplete="off">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">East</label>
              <input type="number" step="0.01"
                     data-admin--poi-categories--poi-category--osm-import-component-target="customEast"
                     class="field-input w-full"
                     autocomplete="off">
            </div>
          </div>
        </div>

        <%# Кнопки выбора локации %>
        <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
          <%= render Ui::BtnComponent.new(color: :ghost, size: :md, html: { data: { action: "click->admin--poi-categories--poi-category--osm-import-component#close" } }) do %>
            <%# MDI: close %>
            <i class="mdi mdi-close"></i>
            <%= t(".cancel") %>
          <% end %>
          <%= render Ui::BtnComponent.new(color: :primary, size: :md, html: { data: { action: "click->admin--poi-categories--poi-category--osm-import-component#startImport", "admin--poi-categories--poi-category--osm-import-component-target": "importBtn" } }) do %>
            <%# MDI: cloud-download %>
            <i class="mdi mdi-cloud-download"></i>
            <%= t(".import") %>
          <% end %>
        </div>
      </div>

      <%# --- Прогресс импорта (показывается после старта) --- %>
      <div class="hidden space-y-4"
           data-admin--poi-categories--poi-category--osm-import-component-target="progressPanel">
        <%# Статус импорта (над прогресс-баром) — сводка по OSM/БД %>
        <div class="flex items-center gap-3 text-sm text-emerald-600">
          <!-- mdi: loading (анимация спиннера) -->
          <i class="mdi mdi-loading mdi-spin text-xl"
             data-admin--poi-categories--poi-category--osm-import-component-target="progressSpinner"></i>
          <span data-admin--poi-categories--poi-category--osm-import-component-target="progressStatusText"><%= t(".fetching") %></span>
        </div>

        <%# Прогресс-бар %>
        <div>
          <div class="w-full bg-gray-200 rounded-full h-2.5">
            <div class="bg-emerald-500 h-2.5 rounded-full transition-all duration-300 ease-out"
                 style="width: 0%"
                 data-admin--poi-categories--poi-category--osm-import-component-target="progressBar"></div>
          </div>
          <%# ПОД прогресс-баром: X of Y (Z%) по центру %>
          <div class="text-xs text-gray-500 mt-1 text-center"
               data-admin--poi-categories--poi-category--osm-import-component-target="progressCounter">
            0 of 0 (0%)
          </div>
        </div>

        <%# Кнопка закрытия (активна только после завершения) %>
        <div class="flex items-center justify-end pt-2">
          <%= render Ui::BtnComponent.new(color: :ghost, size: :md, html: { data: { action: "click->admin--poi-categories--poi-category--osm-import-component#close", "admin--poi-categories--poi-category--osm-import-component-target": "closeBtn" } }) do %>
            <%# MDI: close %>
            <i class="mdi mdi-close"></i>
            <%= t(".close") %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
