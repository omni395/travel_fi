<%# frozen_string_literal: true %>
<%#
# Admin::PoiCategories::PoiCategory::EditComponent - форма редактирования категории POI
#
# Использует Ui::CardComponent, Ui::BtnComponent
# Отправляет через Reflex Admin::PoiCategoriesReflex#update
# %>
<%= render Ui::CardComponent.new do |card| %>
  <% card.with_body do %>
    <%= form_with model: category,
                  url: category.persisted? ? admin_poi_category_path(id: category) : admin_poi_categories_path,
                  method: category.persisted? ? :patch : :post,
                  data: { controller: "admin--poi-categories--poi-category--edit-component",
                          action: "submit->admin--poi-categories--poi-category--edit-component#handleSubmit",
                          reflex_serialize_form: false,
                          id: category.persisted? ? category.id : nil,
                          "admin--poi-categories--poi-category--edit-component-upload-category-icon-path" => upload_category_icon_path,
                          "admin--poi-categories--poi-category--edit-component-remove-category-icon-path" => remove_category_icon_path } do |f| %>

      <%# Name (локализованные поля) %>
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          <!-- mdi: translate -->
          <i class="mdi mdi-translate mr-1"></i>
          <%= t(".name") %>
          <span class="text-red-500">*</span>
        </label>
        <div class="grid grid-cols-2 gap-3">
          <% locales.each do |locale| %>
            <div>
              <span class="text-xs text-gray-400 uppercase"><%= locale %></span>
              <%# Для en: слушаем input для авто-заполнения slug + обязательно %>
              <%= text_field_tag "poi_category[name][#{locale}]", localized_value(:name, locale),
                                 autocomplete: "off",
                                 class: "field-input mt-1",
                                 placeholder: t("locales.#{locale}"),
                                 data: (locale == "en" ? { action: "input->admin--poi-categories--poi-category--edit-component#autoFillSlug" } : {}),
                                 required: (locale == "en") %>
            </div>
          <% end %>
        </div>
      </div>

      <%# ID (hidden) — для create/update в Reflex %>
      <% if category.persisted? %>
        <%= f.hidden_field :id %>
      <% end %>

      <%# Slug (авто-заполняется из name[en], но перезаписывается при ручном вводе) %>
      <div class="mb-6">
        <%= f.label :slug, class: "block text-sm font-medium text-gray-700 mb-1" do %>
          <!-- mdi: link-variant -->
          <i class="mdi mdi-link-variant mr-1"></i>
          <%= t(".slug") %>
          <span class="text-red-500">*</span>
        <% end %>
        <%= f.text_field :slug,
                         autocomplete: "off",
                         required: true,
                         class: "field-input",
                         data: {
                           "admin--poi-categories--poi-category--edit-component_target": "slugInput",
                           action: "input->admin--poi-categories--poi-category--edit-component#markSlugEdited"
                         } %>
      </div>

      <%# Icon (MDI класс + превью) %>
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-1">
          <!-- mdi: icon-picker -->
          <i class="mdi mdi-icon-picker mr-1"></i>
          <%= t(".icon") %>
        </label>
        <div class="flex items-center gap-3">
          <span class="text-emerald-500 text-2xl">
            <i class="mdi <%= category.icon.presence || 'mdi-map-marker' %>" data-admin--poi-categories--poi-category--edit-component-target="iconPreview"></i>
          </span>
          <%= f.text_field :icon,
                           data: { action: "input->admin--poi-categories--poi-category--edit-component#previewIcon",
                                   "admin--poi-categories--poi-category--edit-component_target" => "iconInput" },
                           autocomplete: "off",
                           placeholder: "mdi-icon-name",
                           class: "field-input flex-1" %>
        </div>
      </div>

      <%# Map icon (картинка-маркер категории). Реактивное превью через FileReader.
          Загрузка/удаление — HTTP/multipart (не Reflex), live-обновление через Broadcaster.
          Доступно только для сохранённой категории (нужен id для upload-маршрута).
          Иконка: mdi-image-outline, mdi-upload, mdi-delete %>
      <% if category.persisted? %>
      <div class="mb-6 pt-4 border-t border-gray-200">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          <!-- mdi: image-outline -->
          <i class="mdi mdi-image-outline mr-1"></i>
          <%= t(".map_icon_label") %>
        </label>
        <p class="mb-2 text-xs text-gray-500"><%= t(".map_icon_hint") %></p>

        <div class="flex items-center gap-4">
          <%# Текущая картинка / превью выбранного файла %>
          <div class="shrink-0 w-16 h-16 rounded-xl overflow-hidden bg-emerald-50 flex items-center justify-center">
            <% if category_icon_url.present? %>
              <img src="<%= category_icon_url %>"
                   alt="<%= t(".map_icon_alt") %>"
                   data-admin--poi-categories--poi-category--edit-component-target="iconImage"
                   class="w-full h-full object-cover">
            <% else %>
              <span class="text-emerald-500 text-3xl">
                <i class="mdi mdi-map-marker" data-admin--poi-categories--poi-category--edit-component-target="iconPlaceholder"></i>
                <%# Иконка: mdi-map-marker (fallback пока картинки нет) %>
              </span>
            <% end %>
          </div>

          <div class="flex-1 space-y-2">
            <label class="cursor-pointer inline-flex items-center gap-2 text-sm text-emerald-700 hover:text-emerald-800">
              <!-- mdi: upload -->
              <i class="mdi mdi-upload"></i>
              <%= t(".map_icon_choose") %>
              <input type="file"
                     accept="image/jpeg,image/png,image/webp"
                     class="sr-only"
                     autocomplete="off"
                     data-action="change->admin--poi-categories--poi-category--edit-component#previewCategoryIcon">
            </label>

            <div class="flex items-center gap-2">
              <button type="button"
                      class="btn-ui btn-ui--primary btn-ui--sm"
                      data-action="click->admin--poi-categories--poi-category--edit-component#uploadCategoryIcon">
                <!-- mdi: cloud-upload -->
                <i class="mdi mdi-cloud-upload mr-1"></i>
                <%= t(".map_icon_upload") %>
              </button>
              <% if category_icon_url.present? %>
                <button type="button"
                        class="btn-ui btn-ui--danger btn-ui--sm"
                        data-action="click->admin--poi-categories--poi-category--edit-component#removeCategoryIcon">
                  <!-- mdi: delete -->
                  <i class="mdi mdi-delete mr-1"></i>
                  <%= t(".map_icon_remove") %>
                </button>
              <% end %>
            </div>
            <span class="text-xs text-gray-500" data-admin--poi-categories--poi-category--edit-component-target="iconStatus"></span>
          </div>
        </div>
      </div>
      <% end %>

      <%# Description (локализованные) %>
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          <!-- mdi: text-box-outline -->
          <i class="mdi mdi-text-box-outline mr-1"></i>
          <%= t(".description") %>
        </label>
        <div class="grid grid-cols-2 gap-3">
          <% locales.each do |locale| %>
            <div>
              <span class="text-xs text-gray-400 uppercase"><%= locale %></span>
              <%= text_area_tag "poi_category[description][#{locale}]", localized_value(:description, locale),
                                rows: 3,
                                autocomplete: "off",
                                class: "field-input mt-1",
                                placeholder: t("locales.#{locale}") %>
            </div>
          <% end %>
        </div>
      </div>

      <%# ID (read-only) и Active %>
      <div class="mb-6 flex items-center gap-8">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            <!-- mdi: identifier -->
            <i class="mdi mdi-identifier mr-1"></i>
            <%= t(".id") %>
          </label>
          <p class="text-sm text-gray-900 py-2 px-3 bg-gray-50 rounded-md border border-gray-200"><%= category.id %></p>
        </div>
        <div class="flex items-center gap-2 mt-6">
          <%= f.check_box :active, class: "toggle-input" %>
          <%= f.label :active, t(".active"), class: "text-sm text-gray-700" %>
        </div>
      </div>

      <%# --- OSM Import Settings --- %>
      <div class="mb-6 pt-4 border-t border-gray-200">
        <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-3">
          <!-- mdi: cloud-download -->
          <i class="mdi mdi-cloud-download mr-1"></i>
          <%= t(".osm_settings") %>
        </h3>

        <%# OSM Tags %>
        <div class="mb-4">
          <%= label_tag "poi_category[osm_tags]", class: "block text-sm font-medium text-gray-700 mb-1" do %>
            <!-- mdi: tag-text-outline -->
            <i class="mdi mdi-tag-text-outline mr-1"></i>
            <%= t(".osm_tags_label") %>
          <% end %>
          <%= text_field_tag "poi_category[osm_tags]", osm_tags_string,
                             autocomplete: "off",
                             placeholder: "amenity=toilets, amenity=shower",
                             class: "field-input w-full" %>
          <p class="mt-1 text-xs text-gray-500"><%= t(".osm_tags_hint") %></p>
        </div>

        <%# OSM Default Name %>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            <!-- mdi: translate -->
            <i class="mdi mdi-translate mr-1"></i>
            <%= t(".osm_default_name_label") %>
          </label>
          <div class="grid grid-cols-2 gap-3">
            <% locales.each do |locale| %>
              <div>
                <span class="text-xs text-gray-400 uppercase"><%= locale %></span>
                <%= text_field_tag "poi_category[osm_default_name][#{locale}]", localized_value(:osm_default_name, locale),
                                   autocomplete: "off",
                                   class: "field-input mt-1",
                                   placeholder: t("locales.#{locale}") %>
              </div>
            <% end %>
          </div>
          <p class="mt-1 text-xs text-gray-500"><%= t(".osm_default_name_hint") %></p>
        </div>
      </div>

    <% end %>

    <%# --- Поля категории (CRUD полей встроен в форму редактирования) --- %>
    <%# Секция вынесена НАРУЖУ формы категории: вложение двух форм (форма категории +
        форма поля) браузер игнорирует, и поле не создаётся. Контейнер
        [data-poi-category-fields-edit] перерисовывает PoiCategoryBroadcaster
        (inner_html) после создания/удаления/правки/реордера поля. В show-режиме
        используется отдельный контейнер [data-poi-category-fields] во вкладке
        "Fields" — на странице всегда ровно один из них. %>
    <% if category.persisted? %>
      <div class="mt-6" data-poi-category-fields-edit>
        <%= render Admin::PoiCategories::PoiCategory::FieldsListComponent.new(
              category: category,
              add_button: true,
              with_form: true
            ) %>
      </div>
    <% end %>

    <%# Единая секция кнопок в самом низу формы: Cancel | Save ... Delete (только для админа).
        Save — кнопка type=button, программно сабмитит форму через Reflex (см. submitForm).
        Delete — тип button, открывает диалог подтверждения (requestDelete). %>
    <div class="mt-6 flex items-center gap-3 pt-4 border-t border-gray-200">
      <%= link_to category.persisted? ? admin_poi_category_path(id: category) : admin_poi_categories_path,
                  class: "btn-ui btn-ui--ghost btn-ui--md" do %>
        <%# MDI: close %>
        <i class="mdi mdi-close"></i>
        <%= t(".cancel") %>
      <% end %>

      <%= render Ui::BtnComponent.new(
            color: :primary,
            size: :md,
            html: {
              type: "button",
              data: { action: "click->admin--poi-categories--poi-category--edit-component#submitForm" },
              "admin--poi-categories--poi-category--edit-component_target" => "submitButton"
            }
          ) do %>
        <%# MDI: content-save %>
        <i class="mdi mdi-content-save mr-1"></i>
        <%= t(".save") %>
      <% end %>

      <% if category.persisted? && can_destroy? %>
        <div class="flex-1"></div>
        <%= render Ui::BtnComponent.new(
              color: :danger,
              size: :md,
              html: { data: { action: "click->admin--poi-categories--poi-category--edit-component#requestDelete" } }
            ) do %>
          <%# MDI: delete %>
          <i class="mdi mdi-delete mr-1"></i>
          <%= t(".delete") %>
        <% end %>
      <% end %>
    </div>

    <%# Диалог подтверждения удаления категории (действие выполняет Reflex — confirm_url: nil) %>
    <% if category.persisted? && can_destroy? %>
      <%= render Ui::ConfirmDialogComponent.new(
            title: t(".delete_confirm_title"),
            message: t(".delete_confirm_message"),
            confirm_text: t(".delete"),
            cancel_text: t(".cancel"),
            confirm_variant: :danger,
            confirm_url: nil,
            confirm_method: :get
          ) %>
    <% end %>
  <% end %>
<% end %>
