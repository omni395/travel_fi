<%# Admin Dashboard Component - дашборд админки %>
<%# Отображает статистику и последние активности %>

<div class="p-6">
  <%# Заголовок страницы %>
  <h1 class="text-3xl font-bold text-primary mb-6">
    <%= t('.title') %>
  </h1>

  <%# Статистика %>
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 mb-8">
    <% @stats.each do |key, value| %>
      <%= render Admin::Dashboard::StatCardComponent.new(
            title: stat_label(key),
            count: value,
            icon: stat_icon_name(key),
            color: stat_color(key)
          ) %>
    <% end %>
  </div>

  <%# Последние пользователи %>
  <div class="card-ui mb-8">
    <div class="p-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">
        <%= t('.recent_users') %>
      </h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('admin.users.name') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('admin.users.email') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('admin.users.status') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('admin.users.created_at') %></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @recent_users.each do |user| %>
              <tr class="<%= cycle('bg-white', 'bg-gray-50') %>">
                <td class="px-6 py-4 whitespace-nowrap"><%= user.name %></td>
                <td class="px-6 py-4 whitespace-nowrap"><%= user.email %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full <%= user_status_class(user.status) %>">
                    <%= t("activerecord.attributes.user.statuses.#{user.status}") %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= render Ui::DateComponent.new(user.created_at) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%# Последние активности %>
  <div class="card-ui overflow-hidden">
    <div class="p-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">
        <%= t('.recent_activities') %>
      </h2>
      <div class="space-y-4">
        <% @recent_activities.each do |version| %>
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <div class="h-8 w-8 rounded-full bg-secondary/10 flex items-center justify-center">
                <!-- mdi: history -->
                <i class="mdi mdi-history text-secondary text-xl"></i>
              </div>
            </div>
            <div class="ml-4 flex-1 bg-gray-50 rounded-md p-3">
              <p class="text-sm text-gray-700 font-semibold">
                <%= version.item_type %>#<%= version.item_id %>
              </p>
              <p class="text-xs text-gray-500">
                <%= t("user_audit.actions.#{version.event}") %>
              </p>
              <p class="text-xs text-gray-400">
                <%= render Ui::DateComponent.new(version.created_at) %>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
