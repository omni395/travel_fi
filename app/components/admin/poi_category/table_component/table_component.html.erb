<%# Admin::PoiCategory::TableComponent - таблица категорий POI %>
<div data-admin-poi-categories-list>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".position") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".icon") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".name") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".slug") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".fields_count") %>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".status") %>
          </th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
            <%= t(".actions") %>
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% categories.each do |category| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= category.position %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <% if category.icon.present? %>
                <i class="mdi <%= category.icon %> text-emerald-500 text-lg"></i>
                <%# Иконка: динамическая из category.icon %>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <%= link_to admin_poi_category_path(category), class: "text-sm font-medium text-emerald-600 hover:text-emerald-800" do %>
                <%= category.localized_name %>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <code class="text-xs bg-gray-100 px-2 py-0.5 rounded"><%= category.slug %></code>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= category.poi_category_fields.count %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if category.active %>
                <span class="px-2 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                  <%= t(".active") %>
                </span>
              <% else %>
                <span class="px-2 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                  <%= t(".inactive") %>
                </span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to admin_poi_category_path(category), class: "text-emerald-600 hover:text-emerald-800 mr-3" do %>
                <i class="mdi mdi-eye"></i>
                <%# Иконка: mdi-eye %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if pagy %>
    <div class="px-6 py-4 border-t border-gray-200">
      <%== pagy_nav(pagy) if pagy.pages > 1 %>
    </div>
  <% end %>
</div>
