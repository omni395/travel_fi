<%# frozen_string_literal: true %>

<%#
# app/components/admin/user_edit_component.html.erb - форма редактирования пользователя
#
# Отображает:
# - Форму редактирования пользователя
# - Управление ролями пользователя
# %>

<div class="card bg-base-100 shadow-xl mb-6" data-admin-user-detail>
  <div class="card-body">
    <div class="flex items-center justify-between mb-6">
      <h2 class="card-title text-2xl font-bold text-gray-900">
        <%= t('admin.users.edit_title', name: user.name) %>
      </h2>
      <button data-action="click->admin-users#cancelEdit"
              data-user-id="<%= user.id %>"
              class="btn btn-ghost">
        <%= t('admin.users.cancel') %>
      </button>
    </div>

    <div class="space-y-6">
      <%# Имя %>
      <div class="form-control">
        <label class="label">
          <span class="label-text"><%= t('admin.users.name') %></span>
        </label>
        <input type="text"
               id="user_name"
               name="name"
               value="<%= user.name %>"
               data-action="change->admin-users#updateField"
               data-field="name"
               data-user-id="<%= user.id %>"
               class="input input-bordered w-full">
      </div>

      <%# Email %>
      <div class="form-control">
        <label class="label">
          <span class="label-text"><%= t('admin.users.email') %></span>
        </label>
        <input type="email"
               id="user_email"
               name="email"
               value="<%= user.email %>"
               data-action="change->admin-users#updateField"
               data-field="email"
               data-user-id="<%= user.id %>"
               class="input input-bordered w-full">
      </div>

      <%# Статус %>
      <div class="form-control">
        <label class="label">
          <span class="label-text"><%= t('admin.users.status') %></span>
        </label>
        <select id="user_status"
                name="status"
                data-action="change->admin-users#updateField"
                data-field="status"
                data-user-id="<%= user.id %>"
                class="select select-bordered w-full">
          <option value="active" <%= 'selected' if user.status == 'active' %>>
            <%= t('activerecord.attributes.user.statuses.active') %>
          </option>
          <option value="suspended" <%= 'selected' if user.status == 'suspended' %>>
            <%= t('activerecord.attributes.user.statuses.suspended') %>
          </option>
          <option value="banned" <%= 'selected' if user.status == 'banned' %>>
            <%= t('activerecord.attributes.user.statuses.banned') %>
          </option>
          <option value="pending_verification" <%= 'selected' if user.status == 'pending_verification' %>>
            <%= t('activerecord.attributes.user.statuses.pending_verification') %>
          </option>
        </select>
      </div>

      <%# Кнопки действий %>
      <div class="flex gap-4">
        <button data-action="click->admin-users#save"
                data-user-id="<%= user.id %>"
                class="btn btn-primary">
          <%= t('admin.users.save') %>
        </button>
      </div>
    </div>
  </div>
</div>

<%# Управление ролями %>
<div class="card bg-base-100 shadow-xl">
  <div class="card-body">
    <h2 class="card-title text-xl font-semibold text-gray-800 mb-4">
      <%= t('admin.users.manage_roles') %>
    </h2>

    <div class="space-y-2">
      <% roles.each do |role| %>
        <div class="flex items-center justify-between p-3 border rounded-lg">
          <div>
            <span class="font-medium text-gray-900">
              <%= role.name %>
            </span>
            <span class="ml-2 text-sm text-gray-500">
              <%= t("admin.roles.#{role.name}") %>
            </span>
          </div>

          <% if user_has_role?(role) %>
            <button data-action="click->admin-users#removeRole"
                    data-role-id="<%= role.id %>"
                    data-user-id="<%= user.id %>"
                    class="btn btn-sm btn-error">
              <%= t('admin.users.remove_role') %>
            </button>
          <% else %>
            <button data-action="click->admin-users#addRole"
                    data-role-id="<%= role.id %>"
                    data-user-id="<%= user.id %>"
                    class="btn btn-sm btn-success">
              <%= t('admin.users.add_role') %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
