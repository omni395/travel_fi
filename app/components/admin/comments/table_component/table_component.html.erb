<%# Admin::Comments::TableComponent — таблица модерации комментариев %>
<%# Иконки: mdi-eye, mdi-eye-off, mdi-delete, mdi-comment-text-outline %>
<div class="admin-comments-table-component" data-controller="admin--comments--table-component">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-teal-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-teal-800 uppercase tracking-wider"><%= t(".comment") %></th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-teal-800 uppercase tracking-wider"><%= t(".author") %></th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-teal-800 uppercase tracking-wider"><%= t(".poi") %></th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-teal-800 uppercase tracking-wider"><%= t(".date") %></th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-teal-800 uppercase tracking-wider"><%= t(".votes") %></th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-teal-800 uppercase tracking-wider"><%= t(".status") %></th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-teal-800 uppercase tracking-wider"><%= t(".actions") %></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-100">
        <% comments.each do |comment| %>
          <%= render Admin::Comments::RowComponent.new(comment: comment) %>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if pagy.present? %>
    <div class="mt-4">
      <%= render Ui::PaginationComponent.new(pagy: pagy) if defined?(Ui::PaginationComponent) %>
    </div>
  <% end %>
</div>
