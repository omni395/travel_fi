<%# Admin::Comments::PoiComment::ShowComponent — детальная страница комментария %>
<%# Иконки: mdi-arrow-up-bold, mdi-arrow-down-bold, mdi-eye, mdi-eye-off, mdi-delete, mdi-reply, mdi-message-reply-text, mdi-clipboard-text-search %>
<div class="admin-comments-poi-comment-show-component" data-controller="admin--comments--poi-comment--show-component">
  <%= render Ui::CardComponent.new do |card| %>
    <% card.with_header do %>
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">
            <%# Иконка: mdi-message-reply-text %>
            <i class="mdi mdi-message-reply-text mr-1 text-teal-600"></i><%= comment.body %>
          </h3>
          <p class="text-sm text-gray-500 mt-1">
            <%= t(".author") %>: <span class="font-medium text-gray-700"><%= comment.user&.name || comment.user&.email %></span>
            · <%= render Ui::DateComponent.new(comment.created_at, format: :long) %>
          </p>
        </div>
        <% if comment.hidden? %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-700">
            <%# Иконка: mdi-eye-off %>
            <i class="mdi mdi-eye-off mr-1"></i><%= t(".hidden") %>
          </span>
        <% end %>
      </div>
    <% end %>

    <% card.with_body do %>
      <%# Связка Precedence: родитель %>
      <% if parent %>
        <div class="mb-4 p-3 bg-gray-50 rounded-md border border-gray-200">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">
            <%# Иконка: mdi-reply %>
            <i class="mdi mdi-reply mr-1"></i><%= t(".parent") %>
          </p>
          <p class="text-sm text-gray-700">
            <%= link_to parent.body.truncate(120), admin_comment_path(id: parent), class: "text-emerald-700 hover:text-emerald-900 hover:underline" %>
            <span class="text-gray-400">— <%= parent.user&.name || parent.user&.email %></span>
          </p>
        </div>
      <% end %>

      <div class="flex items-center gap-4 text-sm mb-4">
        <span class="flex items-center text-emerald-600 font-medium">
          <%# Иконка: mdi-arrow-up-bold %>
          <i class="mdi mdi-arrow-up-bold mr-0.5"></i><%= vote_tally[:ups] %>
        </span>
        <span class="flex items-center text-rose-500 font-medium">
          <%# Иконка: mdi-arrow-down-bold %>
          <i class="mdi mdi-arrow-down-bold mr-0.5"></i><%= vote_tally[:downs] %>
        </span>
        <span class="text-gray-500"><%= t(".children_count", count: comment.children_count.to_i) %></span>
      </div>

      <%# Связка Precedence: дети (прямые ответы) %>
      <% if children.any? %>
        <div class="mb-4">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2"><%= t(".children") %></p>
          <ul class="space-y-2">
            <% children.each do |child| %>
              <li class="p-3 bg-teal-50/50 rounded-md border border-teal-100">
                <p class="text-sm text-gray-800">
                  <%= link_to child.body.truncate(140), admin_comment_path(id: child), class: "text-emerald-700 hover:text-emerald-900 hover:underline" %>
                </p>
                <p class="text-xs text-gray-500 mt-1"><%= child.user&.name || child.user&.email %></p>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Кнопки действий %>
      <div class="flex gap-2 mb-6">
        <% if comment.hidden? && can_moderate? %>
          <%= render Ui::BtnComponent.new(
                color: :primary, size: :sm,
                html: { type: "button", data: { action: "admin--comments--poi-comment--show-component#unhide", comment_id: comment.id } }
              ) do %>
            <%# Иконка: mdi-eye %>
            <i class="mdi mdi-eye mr-1"></i><%= t("admin.comments.actions.unhide") %>
          <% end %>
        <% elsif can_moderate? %>
          <%= render Ui::BtnComponent.new(
                color: :secondary, size: :sm,
                html: { type: "button", data: { action: "admin--comments--poi-comment--show-component#hide", comment_id: comment.id } }
              ) do %>
            <%# Иконка: mdi-eye-off %>
            <i class="mdi mdi-eye-off mr-1"></i><%= t("admin.comments.actions.hide") %>
          <% end %>
        <% end %>
        <% if can_destroy? %>
          <%= render Ui::BtnComponent.new(
                color: :danger, size: :sm,
                html: { type: "button", data: { action: "admin--comments--poi-comment--show-component#destroy", comment_id: comment.id } }
              ) do %>
            <%# Иконка: mdi-delete %>
            <i class="mdi mdi-delete mr-1"></i><%= t("admin.comments.actions.destroy") %>
          <% end %>
        <% end %>
      </div>

      <%# Аудит %>
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">
          <%# Иконка: mdi-clipboard-text-search %>
          <i class="mdi mdi-clipboard-text-search mr-1"></i><%= t(".audit") %>
        </p>
        <% if versions.any? %>
          <% versions.each do |v| %>
            <%= render Ui::AuditEntryComponent.new(version: v) %>
          <% end %>
        <% else %>
          <%= render Ui::AuditEntryComponent.new(version: nil) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
