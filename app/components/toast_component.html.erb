<div 
  id="<%= @id %>" 
  role="alert"
  data-controller="toast"
  data-toast-auto-dismiss-timeout-value="<%= @auto_dismiss %>"

  class="flex items-center w-full max-w-sm p-4 <%= @background_color_class %> rounded-lg border <%= @border_color_class %> shadow-xs">
  
  <!-- Icon -->
  <div class="flex items-center justify-center shrink-0 w-7 h-7 <%= @icon_bg_color_class %> rounded">
    <i class="<%= icon_class %> text-base <%= @icon_color_class %>" aria-hidden="true"></i>
  </div>

  <!-- Message -->
  <div class="ms-3 text-sm font-normal <%= @text_color_class %>">
    <%= simple_format(@message, {}, { wrapper_tag: 'span', class: 'block' }) %>
  </div>

  <!-- Close button -->
  <% if @dismissible %>
    <button 
      type="button"
      data-action="click->toast#dismiss"
      aria-label="<%= t('common.close', default: 'Close') %>"
      class="ms-auto flex items-center justify-center <%= @text_color_class %> hover:<%= @text_color_class %> bg-transparent box-border border border-transparent hover:bg-opacity-20 focus:ring-4 focus:ring-opacity-30 font-medium leading-5 rounded text-sm h-8 w-8 focus:outline-none">
      <span class="sr-only"><%= t('common.close', default: 'Close') %></span>
      <i class="mdi mdi-close text-lg"></i>
    </button>
  <% end %>
</div>

