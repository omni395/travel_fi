<%# Poi::DetailComponent - модалка создания/редактирования и просмотра POI %>
<%# Иконка: mdi-plus-circle / mdi-pencil / mdi-information-outline %>
<div data-controller="poi--detail-component"
     data-poi--detail-component-target="overlay"
     data-poi--detail-component-initial-lat="<%= initial_lat %>"
     data-poi--detail-component-initial-lng="<%= initial_lng %>"
     class="fixed inset-0 z-50 hidden"
     data-action="keydown.esc->poi--detail-component#close">
  <div class="absolute inset-0 bg-black/50" data-action="click->poi--detail-component#close"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">

      <%# Детальный просмотр POI (рендерится через StimulusReflex + CableReady) %>
      <div id="poi-detail-modal-content" class="hidden">
        <div id="poi-detail-modal-body"></div>
      </div>

      <%# Форма создания/редактирования POI %>
      <div id="poi-form-content">
        <%= form_with model: edit_mode? ? poi : Poi.new, url: form_url, method: form_method, local: true, class: "p-6" do |f| %>
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-semibold text-gray-900">
              <% if edit_mode? %>
                <i class="mdi mdi-pencil text-emerald-500 mr-2"></i>
              <% else %>
                <i class="mdi mdi-plus-circle text-emerald-500 mr-2"></i>
              <% end %>
              <%# Иконка: mdi-plus-circle / mdi-pencil %>
              <%= edit_mode? ? t(".edit_title") : t(".new_title") %>
            </h3>
            <button type="button"
                    data-action="poi--detail-component#close"
                    class="text-gray-400 hover:text-gray-600">
              <i class="mdi mdi-close text-xl"></i>
              <%# Иконка: mdi-close %>
            </button>
          </div>

          <%# Название %>
          <div class="mb-4">
            <%= f.label :name, t(".name"), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :name, required: true,
                  value: edit_mode? ? poi&.localized_name : nil,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
                  placeholder: t(".name_placeholder"),
                  autocomplete: "off" %>
          </div>

          <%# Категория %>
          <div class="mb-4">
            <%= f.label :poi_category_id, t(".category"), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.collection_select :poi_category_id, categories || [], :id, :localized_name,
                  { prompt: t(".category_prompt"), selected: edit_mode? ? poi&.poi_category_id : nil },
                  class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500" %>
          </div>

          <%# Динамические поля категории %>
          <div data-poi--detail-component-target="fieldsContainer" class="mb-4"></div>

          <%# OpenLayers мини-карта с маркером (h-64 = 256px) %>
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1"><%= t(".position") %></label>
            <div data-poi--detail-component-target="miniMap"
                 class="w-full h-64 rounded-lg border border-gray-300 overflow-hidden z-0"></div>
            <p class="text-xs text-gray-400 mt-1"><%= t(".drag_hint") %></p>
          </div>

          <%# Координаты (hidden, обновляются при перетаскивании маркера) %>
          <%= f.hidden_field :latitude, data: { poi__detail_component_target: "latitude" }, value: initial_lat %>
          <%= f.hidden_field :longitude, data: { poi__detail_component_target: "longitude" }, value: initial_lng %>

          <%# Адрес %>
          <div class="mb-4">
            <%= f.label :address, t(".address"), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :address,
                  value: edit_mode? ? poi&.address : nil,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
                  placeholder: t(".address_placeholder"),
                  autocomplete: "street-address" %>
          </div>

          <%# Город %>
          <div class="mb-4">
            <%= f.label :city, t(".city"), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :city,
                  value: edit_mode? ? poi&.city : nil,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
                  autocomplete: "address-level2" %>
          </div>

          <%# Телефон %>
          <div class="mb-4">
            <%= f.label :phone, t(".phone"), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :phone,
                  value: edit_mode? ? poi&.phone : nil,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
                  autocomplete: "tel" %>
          </div>

          <%# Сайт %>
          <div class="mb-4">
            <%= f.label :website, t(".website"), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :website,
                  value: edit_mode? ? poi&.website : nil,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
                  autocomplete: "url" %>
          </div>

          <%# Доступность %>
          <div class="mb-4 flex items-center gap-2">
            <%= f.check_box :wheelchair_accessible,
                  checked: edit_mode? ? poi&.wheelchair_accessible : false,
                  class: "rounded border-gray-300 text-emerald-600 focus:ring-emerald-500" %>
            <%= f.label :wheelchair_accessible, t(".wheelchair"), class: "text-sm text-gray-700" %>
          </div>

          <%# Кнопка %>
          <div class="mt-6">
            <%= f.submit edit_mode? ? t(".save") : t(".submit"),
                  class: "w-full px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-md hover:bg-emerald-700 transition-colors" %>
          </div>
        <% end %>
      </div>

    </div>
  </div>
</div>
