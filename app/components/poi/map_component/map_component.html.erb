<%# Poi::MapComponent - контейнер для OpenLayers карты с тултипом и фильтрами %>
<%# Иконка: mdi-map %>
<%# data-controller устанавливается на родительском контейнере в index.html.erb %>
<%# poi-map-features — скрытый контейнер данных для маркеров карты.
    Заполняется через PoiReflex#load_pois_in_bounds (CableReady morph).
    Содержит элементы с data-poi-id/data-poi-lat/data-poi-lng для _loadPois().
    НЕ зависит от DOM сайдбара. %>
<%# compact — мини-карта формы (без фильтров/кнопки добавления/features/тултипа) %>
<%# В single-режиме (админка: map-таб/show ?edit, мини-карта) контроллер ставится прямо
    на корень компонента — на публичной карте index.html.erb он вешается на родителе.
    Это чинит баг 6: мини-карта не инициализировалась в админ-форме (нет доступа к
    map_component_controller из-за отсутствия data-controller на обёртке). %>
<div class="relative h-full"
     <% if own_controller? %>data-controller="poi--map-component"<% end %>>
  <%# Карта %>
  <div class="poi-map h-full"
       <% if poi.present? %>
       data-poi-single-lat="<%= poi.latitude %>"
       data-poi-single-lng="<%= poi.longitude %>"
       data-poi-interactive="<%= interactive %>"
       <% end %>></div>

  <%# Верхняя панель-оверлей: фильтры (дропдаун) + кнопка добавления POI.
      В compact-режиме (мини-карта формы) оверлей не рендерится. %>
  <% unless compact %>
    <div class="absolute top-4 right-4 z-10 flex items-center gap-2">
      <%# Кнопка фильтров (дропдаун) — только на публичной карте с категориями %>
      <% if categories.present? %>
        <%= render Poi::FiltersComponent.new(categories: categories, variant: :dropdown) %>
      <% end %>

      <%# Кнопка добавления POI %>
      <% if helpers.user_signed_in? %>
        <%= render Ui::BtnComponent.new(
              color: :primary,
              size: :sm,
              html: {
                data: { action: "click->poi--map-component#openAddPoi" }
              }
            ) do %>
          <!-- mdi: plus -->
          <i class="mdi mdi-plus mr-1"></i>
          <%= t(".add_poi") %>
        <% end %>
      <% end %>
    </div>

    <%# Контейнер данных POI для маркеров %>
    <div id="poi-map-features" class="hidden">
      <% if poi.present? %>
        <% feature = PoiService.map_feature_data(poi) %>
        <div data-poi-id="<%= feature[:id] %>"
             data-poi-lat="<%= feature[:lat] %>"
             data-poi-lng="<%= feature[:lng] %>"
             data-poi-name="<%= h(feature[:name]) %>"
             data-poi-icon="<%= h(feature[:icon]) %>"
             data-poi-category-image="<%= h(feature[:category_image]) %>"
             data-poi-category="<%= h(feature[:category]) %>"
             data-poi-category-id="<%= feature[:category_id] %>"
             data-poi-rating="<%= feature[:rating] %>"
             data-poi-address="<%= h(feature[:address]) %>"
             data-poi-user-id="<%= feature[:user_id] %>"
             data-poi-slug="<%= h(feature[:slug]) %>"
             data-poi-photo="<%= h(feature[:photo]) %>"></div>
      <% end %>
    </div>

    <%# Тултип-попап при ховере (OL Overlay) — внутри контейнера карты для корректного позиционирования %>
    <%= render Ui::TooltipComponent.new %>
  <% end %>
</div>
