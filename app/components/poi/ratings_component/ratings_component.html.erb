<%# Poi::RatingsComponent - таб «Рейтинги/голосования» (ЗАГЛУШКА, реализация в ROADMAP) %>
<%# Иконки: mdi-star-outline / mdi-check-circle %>
<div data-controller="poi--ratings-component" class="p-4 space-y-4">
  <%# Текущий readonly-рейтинг %>
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-1">
      <i class="mdi mdi-star text-yellow-400 text-2xl"></i>
      <%# Иконка: mdi-star %>
      <span class="text-2xl font-bold text-gray-900"><%= poi.rating || 0 %></span>
      <span class="text-sm text-gray-400">/ 5</span>
    </div>
    <% if poi.verification_count > 0 %>
      <span class="flex items-center gap-1 text-sm text-gray-500">
        <i class="mdi mdi-check-circle text-emerald-500"></i>
        <%# Иконка: mdi-check-circle %>
        <%= t(".verified_count", count: poi.verification_count) %>
      </span>
    <% end %>
  </div>

  <%# Заглушка голосования %>
  <div class="text-center py-8 text-gray-400 border-t border-gray-100">
    <i class="mdi mdi-star-outline text-4xl mb-3"></i>
    <%# Иконка: mdi-star-outline %>
    <p class="text-sm font-medium text-gray-500"><%= t(".title") %></p>
    <p class="text-xs mt-1"><%= t(".coming_soon") %></p>
  </div>
</div>
