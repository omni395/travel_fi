<%# Poi::FormComponent - форма создания/редактирования POI %>
<%# Row layout: Name+Category | Map | Address | City+Country+Zip | Phone+Website | Wheelchair | Description | Submit %>
<%# Иконка: mdi-plus-circle / mdi-pencil %>
<div data-controller="poi--form-component"
     data-poi--form-component-initial-lat="<%= initial_lat %>"
     data-poi--form-component-initial-lng="<%= initial_lng %>"
     data-poi--form-component-missing-coords="<%= t('.missing_coords') %>">
  <%# ОКНО МОДАЛКИ — основание окна живёт в компоненте (не в index) %>
  <div class="bg-white rounded-lg shadow-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto relative">
    <%= form_with model: edit_mode? ? poi : Poi.new, url: form_url, method: form_method, local: true,
                  html: { class: "p-6", data: { action: "submit->poi--form-component#handleSubmit" } } do |f| %>
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-lg font-semibold text-gray-900">
        <% if edit_mode? %>
          <i class="mdi mdi-pencil text-emerald-500 mr-2"></i>
        <% else %>
          <i class="mdi mdi-plus-circle text-emerald-500 mr-2"></i>
        <% end %>
        <%# Иконка: mdi-plus-circle / mdi-pencil %>
        <%= edit_mode? ? t(".edit_title") : t(".new_title") %>
      </h3>
      <%= render Ui::BtnComponent.new(color: :ghost, size: :sm, html: { data: { action: "poi--form-component#close" } }) do %>
        <%# Иконка: mdi-close %>
        <i class="mdi mdi-close text-xl"></i>
      <% end %>
    </div>

    <%# Row 1: Name + Category %>
    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" do %>
          <%= t(".name") %><sup class="text-red-500 ml-0.5">*</sup>
        <% end %>
        <%= f.text_field :name, required: true,
              value: edit_mode? ? poi&.localized_name : nil,
              class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
              placeholder: t(".name_placeholder"),
              autocomplete: "off" %>
      </div>
      <div>
        <%= f.label :poi_category_id, class: "block text-sm font-medium text-gray-700 mb-1" do %>
          <%= t(".category") %><sup class="text-red-500 ml-0.5">*</sup>
        <% end %>
        <div data-poi--form-component-target="categoryDropdown">
          <%= render Ui::DropdownComponent.new(position: "left", menu_classes: "w-full max-h-60 overflow-y-auto bg-white border border-gray-200") do |dropdown| %>
            <% dropdown.with_trigger do %>
              <button type="button" data-action="ui--dropdown-component#toggle"
                      class="w-full flex items-center gap-2 px-3 py-2 border border-gray-300 rounded-md text-sm bg-white hover:bg-gray-50 transition-colors text-left cursor-pointer focus:ring-emerald-500 focus:border-emerald-500">
                <span class="mdi mdi-shape-outline text-gray-400 shrink-0"></span>
                <span data-poi--form-component-target="categoryName" class="flex-1 truncate text-gray-700"><%= edit_mode? ? poi.poi_category&.localized_name : t(".category_prompt") %></span>
                <span class="mdi mdi-chevron-down text-gray-400 shrink-0"></span>
              </button>
            <% end %>
            <% dropdown.with_menu do %>
              <% (categories || []).each do |cat| %>
                <div class="flex items-center gap-2 px-3 py-2 hover:bg-emerald-50 cursor-pointer border-b border-gray-50 last:border-b-0"
                     data-action="click->poi--form-component#selectCategory"
                     data-category-id="<%= cat.id %>"
                     data-category-name="<%= cat.localized_name %>">
                  <span class="w-5 h-5 flex items-center justify-center text-emerald-500">
                    <i class="mdi <%= cat.icon || 'mdi-map-marker' %> text-sm"></i>
                  </span>
                  <span class="text-sm text-gray-700"><%= cat.localized_name %></span>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <%= f.hidden_field :poi_category_id, value: edit_mode? ? poi&.poi_category_id : nil,
              data: { poi__form_component_target: "categoryId" } %>
      </div>
    </div>

    <%# Динамические поля категории %>
    <%# data-poi-form-fields — цель inner_html для PoiReflex#load_category_fields %>
    <%# В edit-режиме поля выбранной категории рендерятся сразу (без доп. рефлекса),
        иначе из-за пустого контейнера динамические поля не подтягиваются (баг 2). %>
    <div data-poi-form-fields class="mb-4">
      <% if edit_mode? && poi.poi_category.present? %>
        <%= render Poi::FormFieldsComponent.new(category: poi.poi_category) %>
      <% end %>
    </div>

    <%# Row 2: Map %>
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t(".position") %></label>
      <div data-poi--form-component-target="miniMap"
           class="w-full h-64 rounded-lg border border-gray-300 overflow-hidden z-0"></div>
      <p class="text-xs text-gray-400 mt-1"><%= t(".click_hint") %></p>
    </div>

    <%# Координаты под картой %>
    <div class="mb-4 flex items-center gap-4 text-xs text-gray-500 font-mono">
      <span><%= t(".lat") %>: <span data-poi--form-component-target="coordDisplayLat"><%= initial_lat.to_f.round(6) %></span></span>
      <span><%= t(".lng") %>: <span data-poi--form-component-target="coordDisplayLng"><%= initial_lng.to_f.round(6) %></span></span>
    </div>

    <%= f.hidden_field :latitude, data: { poi__form_component_target: "latitude" }, value: initial_lat %>
    <%= f.hidden_field :longitude, data: { poi__form_component_target: "longitude" }, value: initial_lng %>

    <%# Row 3: Address %>
    <div class="mb-4">
      <%= f.label :address, t(".address"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :address,
            value: edit_mode? ? poi&.address : nil,
            class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
            placeholder: t(".address_placeholder"),
            autocomplete: "off" %>
    </div>

    <%# Row 4: City + Country + Zip %>
    <div class="grid grid-cols-[1fr_1fr_100px] gap-4 mb-4">
      <div>
        <%= f.label :city, t(".city"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :city,
              value: edit_mode? ? poi&.city : nil,
              class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
              autocomplete: "off" %>
      </div>
      <div>
        <%= f.label :country, t(".country"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :country,
              value: edit_mode? ? poi&.country : nil,
              class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
              autocomplete: "off" %>
      </div>
      <div>
        <%= f.label :zip_code, t(".zip_code"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :zip_code, maxlength: 5,
              value: edit_mode? ? poi&.zip_code : nil,
              class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
              autocomplete: "off" %>
      </div>
    </div>

    <%# Row 5: Phone + Website %>
    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :phone, t(".phone"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :phone,
              value: edit_mode? ? poi&.phone : nil,
              class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
              autocomplete: "tel" %>
      </div>
      <div>
        <%= f.label :website, t(".website"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :website,
              value: edit_mode? ? poi&.website : nil,
              class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
              autocomplete: "url" %>
      </div>
    </div>

    <%# Row 6: Wheelchair %>
    <div class="mb-4 flex items-center gap-2">
      <%= f.check_box :wheelchair_accessible,
            checked: edit_mode? ? poi&.wheelchair_accessible : false,
            class: "rounded border-gray-300 text-emerald-600 focus:ring-emerald-500" %>
      <%= f.label :wheelchair_accessible, t(".wheelchair"), class: "text-sm text-gray-700" %>
    </div>

    <%# Row 7: Description %>
    <div class="mb-4">
      <%= f.label :description, t(".description"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description,
            value: edit_mode? ? poi&.localized_description : nil,
            rows: 3,
            class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500",
            placeholder: t(".description_placeholder"),
            autocomplete: "off" %>
    </div>

    <%# Row 7.5: Photos (галерея фотографий POI) %>
    <div class="mb-4">
      <%= f.label :photos, t(".photos"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="flex items-center gap-2">
        <%# Одна кнопка — на телефоне системный выбор (галерея + «Сделать фото» внутри пикера).
            Без capture, чтобы не принуждать открывать только камеру. %>
        <%= render Ui::BtnComponent.new(color: :primary, size: :sm, html: { data: { action: "click->poi--form-component#openGallery" } }) do %>
          <i class="mdi mdi-image-plus"></i>
          <%# Иконка: mdi-image-plus %>
          <%= t(".add_photos") %>
        <% end %>
        <%= f.file_field :photos, multiple: true, accept: "image/*",
              class: "hidden",
              data: { poi__form_component_target: "photosInput", action: "change->poi--form-component#previewPhotos" } %>
      </div>
      <%# Превью: существующие фото (edit) + новые (JS) %>
      <div data-poi--form-component-target="photosPreview" class="flex flex-wrap gap-2 mt-2">
        <% if edit_mode? && poi.photos.any? %>
          <% poi.photos.ordered.each do |photo| %>
            <div class="relative w-20 h-20 rounded-md overflow-hidden border border-gray-200 group">
              <img src="<%= begin url_for(photo.image.variant(PhotoService::THUMB) ) rescue asset_path('no-image.png') end %>"
                   alt="<%= t('.photo_alt') %>"
                   class="w-full h-full object-cover">
              <%= render Ui::BtnComponent.new(size: :sm, html: { class: "absolute top-0 right-0 w-5 h-5 bg-red-500 text-white rounded-bl-md p-0 flex items-center justify-center hover:bg-red-600", data: { action: "click->poi--form-component#removeExistingPhoto", photo_id: photo.id } }) do %>
                <i class="mdi mdi-close text-xs"></i>
                <%# Иконка: mdi-close %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
      <p class="text-xs text-gray-400 mt-1"><%= t(".photos_hint") %></p>
      <%# Контейнер для hidden-inputs удаляемых фото (заполняется JS) %>
      <div data-poi--form-component-target="removePhotosInput" class="hidden"></div>
    </div>

    <%# Row 8: Submit %>
    <div class="mt-6">
      <%= f.submit edit_mode? ? t(".save") : t(".submit"),
            class: "w-full px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-md hover:bg-emerald-700 transition-colors cursor-pointer" %>
    </div>
    <% end %>
  </div>
</div>
