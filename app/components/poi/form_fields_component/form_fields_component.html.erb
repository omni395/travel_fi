<%# Poi::FormFieldsComponent - динамические поля выбранной категории POI %>
<%# Корень без селектора [data-poi-form-fields]: цель inner_html живёт на обёртке в Poi::FormComponent %>
<div data-controller="poi--form-fields-component">
  <%# Иконка: mdi-view-list-outline %>
  <h4 class="text-sm font-semibold text-gray-800 mb-2 flex items-center gap-1">
    <i class="mdi mdi-view-list-outline text-emerald-500"></i>
    <%= t(".category_fields") %>
  </h4>

  <% if fields.any? %>
    <% fields.each do |field| %>
      <div class="mb-3" data-key="<%= field.field_key %>">
        <label class="block text-sm font-medium text-gray-700 mb-1" for="poi_metadata_<%= field.field_key %>">
          <%= field.localized_label %>
          <% if field.required %>
            <sup class="text-red-500 ml-0.5">*</sup>
          <% end %>
        </label>

        <% case field.field_type %>
        <% when "boolean" %>
          <input type="checkbox"
                 id="poi_metadata_<%= field.field_key %>"
                 name="poi[metadata][<%= field.field_key %>]"
                 value="1"
                 class="rounded border-gray-300 text-emerald-600 focus:ring-emerald-500">
        <% when "number" %>
          <input type="number"
                 id="poi_metadata_<%= field.field_key %>"
                 name="poi[metadata][<%= field.field_key %>]"
                 placeholder="<%= field.localized_placeholder %>"
                 autocomplete="off"
                 class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500"
                 <% if field.required %>required<% end %>>
        <% when "text" %>
          <textarea id="poi_metadata_<%= field.field_key %>"
                    name="poi[metadata][<%= field.field_key %>]"
                    rows="3"
                    placeholder="<%= field.localized_placeholder %>"
                    autocomplete="off"
                    class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500"
                    <% if field.required %>required<% end %>></textarea>
        <% when "select" %>
          <select id="poi_metadata_<%= field.field_key %>"
                  name="poi[metadata][<%= field.field_key %>]"
                  class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500"
                  <% if field.required %>required<% end %>>
            <option value=""><%= t(".select_prompt") %></option>
            <% field_options(field).each do |value, label| %>
              <option value="<%= value %>"><%= label %></option>
            <% end %>
          </select>
        <% when "multiselect" %>
          <select id="poi_metadata_<%= field.field_key %>"
                  name="poi[metadata][<%= field.field_key %>][]"
                  multiple
                  class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500">
            <% field_options(field).each do |value, label| %>
              <option value="<%= value %>"><%= label %></option>
            <% end %>
          </select>
        <% else %>
          <input type="text"
                 id="poi_metadata_<%= field.field_key %>"
                 name="poi[metadata][<%= field.field_key %>]"
                 placeholder="<%= field.localized_placeholder %>"
                 autocomplete="off"
                 class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-emerald-500 focus:border-emerald-500"
                 <% if field.required %>required<% end %>>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="text-sm text-gray-400"><%= t(".no_fields") %></p>
  <% end %>
</div>
