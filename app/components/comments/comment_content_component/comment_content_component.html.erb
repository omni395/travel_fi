<%# Comments::CommentContentComponent — контент отдельной записи комментария %>
<%# Иконки: mdi-reply, mdi-pencil-outline, mdi-delete-outline, mdi-chevron-down, mdi-alert-circle %>
<div class="flex gap-3">
  <%# Аватар автора %>
  <%= render Ui::AvatarComponent.new(user: comment.user, size: :sm) %>

  <div class="flex-1 min-w-0">
    <%# Шапка: автор · дата · @предок (флоттенинг) %>
    <div class="flex items-center gap-2 text-xs text-gray-500">
      <span class="font-semibold text-gray-700"><%= comment.user.name %></span>
      <span>&middot;</span>
      <span><%= l(comment.created_at, format: :short) %></span>
      <%# Пометка «изменено {кем} {когда}» — по последней PaperTrail-версии body.
          Никакой анонимной метки: редактор (в т.ч. админ) и время правки. %>
      <% if edited? %>
        <span class="text-gray-400 italic">
          <%# Иконка: mdi-pencil-outline %>
          (<i class="mdi mdi-pencil-outline text-[10px]"></i><%= t(".edited_by", name: edited_by_name, time: l(edited_at, format: :short)) %>)
        </span>
      <% end %>
      <% if reply_target_name.present? %>
        <%# Иконка: mdi-reply %>
        <span class="text-teal-600">
          <i class="mdi mdi-reply mr-0.5"></i><%= t(".replying_to", name: reply_target_name) %>
        </span>
      <% end %>
    </div>

    <%# Скрытый модерацией комментарий (порог дизлайков): показываем заглушку
        вместо тела и панели действий. %>
    <% if hidden? %>
      <p class="mt-1 text-xs text-gray-400 italic">
        <%# Иконка: mdi-eye-off-outline %>
        <i class="mdi mdi-eye-off-outline mr-0.5"></i><%= t(".hidden_notice") %>
      </p>
    <% else %>
      <%# Тело комментария %>
      <p class="mt-1 text-sm text-gray-700 whitespace-pre-wrap"><%= comment.body %></p>

      <%# Плашка «Одобрено сообществом» — ups >= порога при стабильном перевесе %>
      <% if community_approved? %>
        <div class="mt-1 inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-[11px] font-medium">
          <%# Иконка: mdi-check-decagram %>
          <i class="mdi mdi-check-decagram text-sm"></i><%= t(".community_approved") %>
        </div>
      <% end %>

      <%# Панель действий: голоса + ответ/редактировать/удалить/модерация %>
      <div class="mt-2 flex items-center gap-3 flex-wrap">
        <%= render Ui::VoteComponent.new(votable: comment, current_user: current_user) %>

        <%# Кнопка «Ответить» — любому залогиненному кроме автора (кнопка скрыта,
            раскрывается клиентским контроллером по data-comment-author-id). %>
        <div data-comments--comment-component-target="replyButton" class="hidden">
          <%= render Ui::BtnComponent.new(
                color: :ghost, size: :xs,
                html: { data: { comments__toggle_reply: true, action: "comments--comment-component#toggleReply" } }
              ) do %>
            <%# Иконка: mdi-reply %>
            <i class="mdi mdi-reply mr-0.5"></i><%= t(".reply") %>
          <% end %>
        </div>

        <%# Действия автора: Изменить — автору (скрыты, раскрываются клиентским
            контроллером по автору). %>
        <div data-comments--comment-component-target="authorActions" class="hidden">
          <%= render Ui::BtnComponent.new(
                color: :ghost, size: :xs,
                html: { data: { comments__toggle_edit: true, action: "comments--comment-component#toggleEdit" } }
              ) do %>
            <%# Иконка: mdi-pencil-outline %>
            <i class="mdi mdi-pencil-outline mr-0.5"></i><%= t(".edit") %>
          <% end %>
        </div>

        <%# Действия staff (admin/moderator): Удалить + пенализация автора.
            Раскрываются клиентским контроллером ТОЛЬКО staff (data-user-role). %>
        <div data-comments--comment-component-target="staffActions" class="hidden">
          <%= render Ui::BtnComponent.new(
                color: :danger, size: :xs,
                html: { data: { action: "click->comments--comment-component#openDeleteDialog" } }
              ) do %>
            <%# Иконка: mdi-delete-outline %>
            <i class="mdi mdi-delete-outline mr-0.5"></i><%= t(".delete") %>
          <% end %>

          <%# Диалог 1: подтверждение удаления (скрытие модерацией). %>
          <div
            data-comments--comment-component-target="deleteDialog"
            data-action="confirmDialogConfirmed->comments--comment-component#onDeleteConfirmed"
          >
            <%= render Ui::ConfirmDialogComponent.new(
                  title: t(".delete_dialog_title"),
                  message: t(".delete_dialog_message"),
                  confirm_text: t(".delete_confirm"),
                  cancel_text: t(".cancel"),
                  confirm_variant: :danger,
                  confirm_url: nil
                ) %>
          </div>

          <%# Диалог 2: автопенализация автора (статус :suspended + авто-разблокировка). %>
          <div
            data-comments--comment-component-target="suspendDialog"
            data-action="confirmDialogConfirmed->comments--comment-component#onSuspendConfirmed"
          >
            <%= render Ui::ConfirmDialogComponent.new(
                  title: t(".suspend_dialog_title"),
                  message: t(".suspend_dialog_message"),
                  confirm_text: t(".suspend_confirm"),
                  cancel_text: t(".cancel"),
                  confirm_variant: :primary,
                  confirm_url: nil
                ) %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Форма ответа (скрыта, раскрывается по кнопке) %>
    <div class="mt-2 hidden" data-comments--comment-component-target="replyForm">
      <%= render Comments::CommentFormComponent.new(
            commentable: comment.poi, current_user: current_user,
            parent: comment, user_lat: user_lat, user_lng: user_lng
          ) %>
    </div>

    <%# Форма редактирования (скрыта; раскрывается JS вместе с authorActions). %>
    <div class="mt-2 hidden" data-comments--comment-component-target="editForm">
      <%= render Comments::CommentFormComponent.new(
            commentable: comment.poi, current_user: current_user,
            comment: comment, user_lat: user_lat, user_lng: user_lng
          ) %>
    </div>

    <%# Свёрнутая ветка: кнопка «Показать N ответов» %>
    <% if collapsed? %>
      <%= render Ui::BtnComponent.new(
            color: :ghost, size: :xs,
            html: { data: { action: "comments--comment-component#expandReplies" } }
          ) do %>
        <%# Иконка: mdi-chevron-down %>
        <i class="mdi mdi-chevron-down mr-0.5"></i><%= t(".show_replies", count: children_count) %>
      <% end %>
    <% end %>
  </div>
</div>
