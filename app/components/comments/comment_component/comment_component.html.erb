<%# Comments::CommentComponent — обёртка отдельной записи комментария (корень или ответ). %>
<%# Иконки: mdi-chevron-down (кнопка «Показать N ответов» в content) %>
<%#
  Структура (важно для точечного broadcast без дублей/самовложения):
    [data-comment-id]          — корневая обёртка (контроллер comments--comment-component)
      ├── [data-comment-content]  — контент (рендерит Comments::CommentContentComponent).
      │                           Broadcaster шлёт СЮДА inner_html при :update (правка тела),
      │                           не трогая детей → нет самовложения [data-comment-id].
      └── [data-comment-children] — ответы (1 уровень). Broadcaster шлёт СЮДА
                                    insert_adjacent_html при :create ответа → вложенность
                                    в родителя вместо top-level дубля.
%>
<div class="comment-component"
     data-controller="comments--comment-component"
     data-comment-id="<%= comment.id %>"
     data-comment-author-id="<%= comment.user_id %>"
     data-comment-replyable="<%= comment.parent.nil? %>"
     data-comment-i-replied="<%= i_replied? %>">

  <%# Контент записи (аватар/шапка/тело/действия/формы) %>
  <div data-comment-content class="<%= comment.parent ? 'ml-6' : '' %>">
    <%= render Comments::CommentContentComponent.new(
          comment: comment,
          current_user: current_user,
          moderation: moderation,
          sort: sort,
          user_lat: user_lat,
          user_lng: user_lng
        ) %>
  </div>

  <%# Дети (ответы, 1 уровень) — контейнер-цель для insert_adjacent при :create ответа %>
  <div data-comment-children>
    <% unless collapsed? %>
      <% if children.any? %>
        <%= render Comments::CommentComponent.with_collection(
              children, current_user: current_user, moderation: moderation, sort: sort,
              user_lat: user_lat, user_lng: user_lng
            ) %>
      <% end %>
    <% end %>
  </div>
</div>
