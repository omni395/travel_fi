<%# Comments::CommentFormComponent — форма создания/ответа на комментарий %>
<%# Иконки: mdi-send, mdi-reply %>
<%
  form_attrs = {
    controller: "comments--comment-form-component",
    commentable_type: commentable.class.name,
    commentable_id: commentable.id,
    parent_id: parent&.id,
    comment_id: comment&.id
  }.compact
%>
<%= content_tag :div, class: "comment-form-component mb-3", data: form_attrs do %>
  <%# Форма БЕЗ action: StimulusReflex при this.stimulate() берёт URL вызова из
      form.action и сверяет с адресной страницей. При action="#" URL-check даёт
      клиентскую ошибку "Reflex failed due to mismatched URL", и reflex не доходит
      до сервера. Без атрибута action Reflex наследует location.href — проверка
      проходит. Основной путь создания — Reflex через WebSocket (токен не участвует);
      authenticity_token добавлен как страховка от случайного нативного POST-фолбэка
      (если Stimulus-контроллер ещё не подхватился). Кнопка submit всегда
      перехватывается data-action="...#submit" — нативный сабмит не происходит. %>
  <form data-comment-form>
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <% if parent %>
      <p class="text-xs text-gray-500 mb-1">
        <%# Иконка: mdi-reply %>
        <i class="mdi mdi-reply mr-0.5"></i><%= reply_to_label %>
      </p>
    <% end %>

    <div class="flex gap-2">
      <textarea name="comment[body]"
                class="w-full rounded-md border border-teal-200 focus:border-teal-500 focus:ring-teal-500 text-sm p-2"
                placeholder="<%= placeholder %>"
                rows="2"
                autocomplete="off"
                required
                data-comments--comment-form-component-target="body"><%= comment&.body if editing? %></textarea>

      <%= render Ui::BtnComponent.new(
            color: :primary, size: :sm, html: { type: "submit", data: { action: "comments--comment-form-component#submit" } }
          ) do %>
        <%# Иконка: mdi-send %>
        <i class="mdi mdi-send mr-0.5"></i><%= submit_label %>
      <% end %>
    </div>
  </form>
<% end %>
