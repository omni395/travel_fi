<!-- Users::ProfileComponent -->
<!-- data-user-profile-id — на обёртке в users/show.html.erb (цель inner_html) -->
<div data-controller="users--profile-component"
     data-users--profile-component-wallet-challenge-url-value="<%= wallet_challenge_path %>"
     data-users--profile-component-wallet-connect-url-value="<%= wallet_connect_path %>"
     data-users--profile-component-wallet-disconnect-url-value="<%= wallet_disconnect_path %>"
     data-users--profile-component-wallet-claim-request-url-value="<%= wallet_claim_request_path %>"
     data-users--profile-component-wallet-claim-url-value="<%= wallet_claim_path %>"
     data-users--profile-component-wallet-chain-id-value="<%= Integer(ENV["CHAIN_ID"].presence || "0x14a34", 0) %>"
     data-users--profile-component-wallet-connect-project-id-value="<%= ENV["WALLETCONNECT_PROJECT_ID"] %>"
     data-users--profile-component-wallet-connecting-value="<%= t(".wallet_connecting") %>"
     data-users--profile-component-wallet-connect-failed-value="<%= t(".wallet_connect_failed") %>"
     data-users--profile-component-walletconnect-unavailable-value="<%= t(".walletconnect_unavailable") %>"
     data-users--profile-component-wallet-disconnect-failed-value="<%= t(".wallet_disconnect_failed") %>"
     data-users--profile-component-wallet-external-connected-value="<%= connected_external_wallet.present? %>"
     data-users--profile-component-claim-signing-value="<%= t(".claim_signing") %>"
     data-users--profile-component-claim-submitted-value="<%= t(".claim_submitted") %>"
     data-users--profile-component-claim-failed-value="<%= t(".claim_failed") %>"
     class="w-full max-w-2xl">

  <%= render Ui::CardComponent.new do |card| %>
    <% card.with_body do %>
      <!-- Header Gradient Background -->
      <div class="h-32 bg-gradient-to-r from-secondary to-primary rounded-t-lg -m-8 mb-0"></div>

      <!-- Avatar Section (overlap with header) -->
      <div class="flex justify-center -mt-16 mb-4">
        <%= render Ui::AvatarComponent.new(user: @user, size: :xl) %>
      </div>

      <!-- User Basic Info -->
      <div class="text-center mb-6 min-w-0">
        <h2 class="text-2xl font-bold text-gray-900 wrap-break-word"><%= @user.name %></h2>
        <p class="text-sm text-gray-600 wrap-break-word"><%= @user.email %></p>

        <!-- Status Badge -->
        <div class="mt-3 flex justify-center">
          <%= render Ui::BadgeComponent.new(color: status_color, size: :md) do %>
            <%= I18n.t("activerecord.attributes.user.statuses.#{@user.status}", default: @user.status.humanize) %>
          <% end %>
        </div>
      </div>

      <% if can_manage_wallet? %>
        <section class="mb-6 rounded-lg border border-gray-200 bg-white p-4" aria-labelledby="profile-wallet-heading">
          <h3 id="profile-wallet-heading" class="mb-3 text-sm font-semibold text-gray-800">
            <i class="mdi mdi-wallet-outline mr-1 text-secondary"></i>
            <%= t(".wallet_address") %>
          </h3>
          <% if connected_external_wallet %>
            <p class="mb-3 text-xs text-gray-500"><%= t(".wallet_connected") %></p>
            <p class="mb-4 break-all font-mono text-sm text-gray-700"><%= connected_external_wallet.address %></p>
            <%= render Ui::BtnComponent.new(color: :secondary, size: :sm, html: {
                  data: { action: "click->users--profile-component#disconnectWallet" }
                }) do %>
              <%= t(".disconnect_wallet") %>
            <% end %>
          <% else %>
            <div class="flex flex-col gap-2 sm:flex-row">
              <%= render Ui::BtnComponent.new(color: :primary, size: :sm, html: {
                    data: { action: "click->users--profile-component#connectMetaMask" }
                  }) do %>
                <i class="mdi mdi-wallet-plus mr-1"></i>
                <%= t(".connect_metamask") %>
              <% end %>
              <% if ENV["WALLETCONNECT_PROJECT_ID"].present? %>
                <%= render Ui::BtnComponent.new(color: :secondary, size: :sm, html: {
                      data: { action: "click->users--profile-component#connectWalletConnect" }
                    }) do %>
                  <%= t(".connect_walletconnect") %>
                <% end %>
              <% end %>
            </div>
          <% end %>
          <p data-users--profile-component-target="walletStatus"
             class="mt-3 break-words text-sm text-gray-600"
             role="status" aria-live="polite"></p>
        </section>
      <% end %>

      <!-- Referral Code Section (prominent, with copy button) -->
      <% if @user.referral_code.present? %>
        <div class="mb-6 border-t border-b border-gray-200 py-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-2">
            <div class="min-w-0">
              <p class="text-xs font-semibold text-gray-700 mb-1">
                <%# MDI: share-variant %>
                <i class="mdi mdi-share-variant text-secondary mr-1"></i>
                <%= t(".referral_code") %>
              </p>
              <p class="text-lg font-mono font-bold text-secondary tracking-wider wrap-break-word">
                <%= @user.referral_code %>
              </p>
            </div>
            <button data-controller="clipboard" data-clipboard-text-value="<%= @user.referral_code %>"
                    data-action="clipboard#copy"
                    class="btn-ui btn-ui--secondary btn-ui--sm flex items-center gap-1">
              <%# MDI: content-copy %>
              <i class="mdi mdi-content-copy"></i>
              <span data-clipboard-target="label"><%= t(".copy_code") %></span>
            </button>
          </div>
          <p class="text-xs text-gray-500 mt-2 px-2 wrap-break-word">
            <%# MDI: information-outline %>
            <i class="mdi mdi-information-outline text-gray-400 mr-1"></i>
            <%= t(".referral_hint", code: @user.referral_code) %>
          </p>
        </div>
      <% end %>

      <!-- Token Balance Section -->
      <div class="mb-4 p-4 bg-gradient-to-r from-emerald-50 to-teal-50 rounded-lg border border-emerald-200">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-xs font-semibold text-gray-700 mb-1">
              <%# MDI: coins %>
              <i class="mdi mdi-coins text-emerald-600 mr-1"></i>
              <%= t(".token_balance") %>
            </p>
            <p class="text-xl font-bold text-emerald-700">
              <%# Баланс = уже забранные (claimed=true) on-chain токены %>
              <%= format_amount(claimed_amount) %> TFT
            </p>
          </div>

          <% if available? %>
            <%= render Ui::BtnComponent.new(color: :primary, size: :sm, html: {
                  data: { action: "click->users--profile-component#claim" }
                }) do %>
              <%# MDI: wallet-plus %>
              <i class="mdi mdi-wallet-plus mr-1"></i>
              <%= t(".claim_button") %>
            <% end %>
          <% end %>
        </div>

        <div class="flex flex-col gap-1 text-sm mt-3">
          <span class="text-emerald-700 font-medium">
            <%# MDI: wallet %>
            <i class="mdi mdi-wallet text-emerald-600 mr-1"></i>
            <%= t(".spendable_balance") %>:
            <span class="font-bold"><%= format_amount(available_amount) %> TFT</span>
          </span>
          <span class="text-teal-600">
            <%# MDI: lock %>
            <i class="mdi mdi-lock text-teal-500 mr-1"></i>
            <%= t(".locked_balance") %>: <%= format_amount(locked_amount) %> TFT
          </span>
        </div>
      </div>

      <!-- Badges Section -->
      <% if @user.badges.present? %>
        <div class="mb-4 p-4 bg-gradient-to-r from-secondary/5 to-primary/5 rounded-lg border border-secondary/20">
          <p class="text-xs font-semibold text-gray-700 mb-3">
            <%# MDI: trophy %>
            <i class="mdi mdi-trophy text-secondary mr-1"></i>
            <%= t(".badges") %>
          </p>
          <div class="flex flex-wrap gap-2">
            <% @user.badges.each do |badge| %>
              <%= render Ui::BadgeComponent.new(color: :secondary, size: :sm) do %>
                <%# MDI: trophy-outline %>
                <i class="mdi mdi-trophy-outline text-secondary mr-1"></i>
                <%= badge %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Roles Section -->
      <div class="mb-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
        <p class="text-xs font-semibold text-gray-700 mb-2">
          <%# MDI: account-group %>
          <i class="mdi mdi-account-group text-gray-600 mr-1"></i>
          <%= t(".roles") %>
        </p>
        <p class="text-sm text-gray-600">
          <% if @user.roles.any? %>
            <% @user.roles.each do |role| %>
              <%= render Ui::BadgeComponent.new(color: :secondary, size: :sm) do %>
                <%= role.name %>
              <% end %>
            <% end %>
          <% else %>
            <span class="text-gray-400">—</span>
          <% end %>
        </p>
      </div>

      <!-- Edit Profile Button -->
      <% if can_edit_profile? %>
        <div class="mt-6">
          <%= link_to t(".edit_profile"), edit_user_path(id: @user),
              class: "btn-ui btn-ui--primary btn-ui--lg w-full block text-center" %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
