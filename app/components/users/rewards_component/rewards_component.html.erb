<%# frozen_string_literal: true %>

<%#
# Users::RewardsComponent — история начислений токенов TFT в профиле юзера.
# Иконка: mdi-coins
# %>

<div data-controller="users--rewards-component" class="rewards-component">
  <%= render Ui::CardComponent.new do |card| %>
    <% card.with_body do %>
      <h3 class="text-lg font-semibold text-gray-800 mb-4">
        <%# Иконка: mdi-coins %>
        <i class="mdi mdi-coins text-emerald-600 mr-1"></i>
        <%= t(".title") %>
      </h3>

      <%# Плашка балансов: заблокировано / доступно к получению %>
      <% if user.token_transactions.unclaimed.any? %>
        <div class="mb-4 p-3 rounded-lg bg-teal-50 border border-teal-200">
          <div class="flex items-center justify-between text-sm">
            <div class="flex flex-col gap-1">
              <span class="text-teal-700 font-medium">
                <%# Иконка: mdi-lock %>
                <i class="mdi mdi-lock text-teal-600 mr-1"></i>
                <%= t(".locked_balance") %>: <%= format_amount(locked_amount) %> TFT
              </span>
              <span class="text-emerald-700 font-medium">
                <%# Иконка: mdi-arrow-down-circle %>
                <i class="mdi mdi-arrow-down-circle text-emerald-600 mr-1"></i>
                <%= t(".available_balance") %>: <%= format_amount(available_amount) %> TFT
              </span>
            </div>
            <% if available? %>
              <%= render Ui::BtnComponent.new(color: :primary, size: :sm, html: {
                    data: { action: "click->users--rewards-component#claim" }
                  }) do %>
                <%# Иконка: mdi-wallet-plus %>
                <i class="mdi mdi-wallet-plus mr-1"></i>
                <%= t(".claim_button") %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if transactions.any? %>
        <ul class="divide-y divide-gray-200">
          <% transactions.each do |tx| %>
            <li class="py-3 flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-800"><%= action_key_label(tx) %></p>
                <p class="text-xs text-gray-500"><%= l(tx.created_at, format: :short) %></p>
              </div>
              <span class="text-sm font-semibold text-emerald-600 whitespace-nowrap">
                +<%= format_amount(tx.amount) %> TFT
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-gray-400"><%= t(".empty") %></p>
      <% end %>
    <% end %>
  <% end %>
</div>
