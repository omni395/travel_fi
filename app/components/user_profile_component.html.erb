<!-- User Profile Card Component -->
<!-- Зелено-голубые цвета градиент from-teal-600 to-sky-600 -->
<!-- data-user-profile-id используется для CableReady морфинга при обновлении -->
<div data-user-profile-id="<%= @user.id %>" class="w-full max-w-2xl rounded-lg border border-teal-200 bg-white shadow-md hover:shadow-lg transition-shadow duration-300">
  
  <!-- Header Gradient Background -->
  <div class="h-32 bg-gradient-to-r from-teal-600 to-sky-600 rounded-t-lg"></div>
  
  <!-- Profile Content Container -->
  <div class="px-6 pb-6 relative">
    
    <!-- Avatar Section (overlap with header) -->
    <div class="flex justify-center -mt-16 mb-4">
      <div class="w-32 h-32 rounded-full border-4 border-white shadow-lg overflow-hidden bg-gray-100">
        <% if @user.avatar.attached? && @user.avatar.blob.variable? %>
          <%= image_tag @user.avatar, class: "w-full h-full object-cover", alt: @user.name %>
        <% else %>
          <!-- Avatar Fallback Gradient -->
          <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-teal-400 to-sky-400">
            <span class="text-4xl font-bold text-white"><%= name_initial %></span>
          </div>
        <% end %>
      </div>
    </div>
    
    <!-- User Basic Info -->
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold text-gray-900"><%= @user.name %></h2>
      <p class="text-sm text-gray-600"><%= @user.email %></p>
      
      <!-- Status Badge -->
      <div class="mt-3 flex justify-center">
        <span class="<%= status_badge_class %>">
          <%= I18n.t("activerecord.attributes.user.statuses.#{@user.status}", default: @user.status.humanize) %>
        </span>
      </div>
    </div>
    
    <!-- Stats Grid (Reputation, Points, Level) -->
    <div class="grid grid-cols-3 gap-4 mb-6 border-t border-b border-gray-200 py-4">
      <!-- Reputation Stat -->
      <div class="text-center">
        <p class="text-2xl font-bold text-teal-600"><%= @user.reputation || 0 %></p>
        <p class="text-xs text-gray-600"><%= t('user.reputation') %></p>
      </div>
      
      <!-- Points Stat -->
      <div class="text-center">
        <p class="text-2xl font-bold text-sky-600"><%= @user.points || 0 %></p>
        <p class="text-xs text-gray-600"><%= t('user.points') %></p>
      </div>
      
      <!-- Level Stat (от Merit) -->
      <div class="text-center">
        <p class="text-2xl font-bold text-cyan-600"><%= @user.level || 0 %></p>
        <p class="text-xs text-gray-600"><%= t('user.level') %></p>
      </div>
    </div>
    
    <!-- Badges Section -->
    <% if @user.badges.present? %>
      <div class="mb-4 p-4 bg-gradient-to-r from-teal-50 to-sky-50 rounded-lg border border-teal-200">
        <p class="text-xs font-semibold text-gray-700 mb-3">
          <!-- Badge Icon: 🏆 -->
          <%= t('user.badges') %>
        </p>
        <div class="flex flex-wrap gap-2">
          <% @user.badges.each do |badge| %>
            <span class="inline-block px-3 py-1 text-xs font-medium rounded-full bg-gradient-to-r from-teal-100 to-sky-100 text-teal-700 border border-teal-300">
              🏆 <%= badge %>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
    
    <!-- Roles Section -->
    <div class="mb-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
      <p class="text-xs font-semibold text-gray-700 mb-2">
        <!-- Role Icon: 👤 -->
        <%= t('user.roles') %>
      </p>
      <p class="text-sm text-gray-600">
        <% if @user.roles.any? %>
          <%= @user.roles.pluck(:name).join(", ") %>
        <% else %>
          <span class="text-gray-400">—</span>
        <% end %>
      </p>
    </div>
    
    <!-- Referral Code Section (if applicable) -->
    <% if @user.referral_code.present? %>
      <div class="mb-4 p-4 bg-gradient-to-r from-teal-50 to-sky-50 rounded-lg border border-teal-200">
        <p class="text-xs font-semibold text-gray-700 mb-2">
          <!-- Link Icon: 🔗 -->
          <%= t('user.referral_code') %>
        </p>
        <p class="text-sm font-mono text-teal-700 break-all">
          <%= @user.referral_code %>
        </p>
      </div>
    <% end %>
    
    <!-- Wallet Address Section (if connected) -->
    <% if @user.wallet_address.present? %>
      <div class="mb-4 p-4 bg-gradient-to-r from-purple-50 to-pink-50 rounded-lg border border-purple-200">
        <p class="text-xs font-semibold text-gray-700 mb-2">
          <!-- Wallet Icon: 💰 -->
          <%= t('user.wallet_address') %>
        </p>
        <p class="text-sm font-mono text-purple-700 break-all">
          <%= @user.wallet_address %>
        </p>
        <% if @user.wallet_provider.present? %>
          <p class="text-xs text-gray-600 mt-1">
            Provider: <strong><%= @user.wallet_provider %></strong>
          </p>
        <% end %>
      </div>
    <% end %>
    
    <!-- Edit Profile Button -->
    <% if can_edit_profile? %>
      <div class="mt-6">
        <%= link_to t('common.edit_profile'), edit_user_path(@user), 
            class: "w-full block text-center px-4 py-3 rounded-lg bg-gradient-to-r from-teal-600 to-sky-600 text-white font-semibold hover:from-teal-700 hover:to-sky-700 transition-all duration-300 shadow-md hover:shadow-lg" %>
      </div>
    <% end %>
    
  </div>
</div>
