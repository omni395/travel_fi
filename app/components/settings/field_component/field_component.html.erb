<%# frozen_string_literal: true %>

<div data-controller="settings--field-component" class="flex items-center justify-between py-3 border-b border-gray-100 last:border-b-0">
  <span class="text-sm font-medium text-gray-700 w-1/3"><%= field_label %></span>

  <div class="flex items-center space-x-6">
    <button type="button" role="switch"
            aria-checked="<%= enabled?(notifications_field) %>"
            data-action="click->settings--field-component#toggle"
            data-field-value="<%= notifications_field %>"
            class="group flex w-6 h-4 p-1 rounded-full bg-slate-400 transition-colors duration-200 ease-in-out overflow-hidden outline-none focus-visible:ring focus-visible:ring-purple-400 aria-checked:bg-teal-400">
      <span class="w-2 h-2 rounded-full bg-white transition-transform duration-200 ease-in-out group-aria-checked:translate-x-full"></span>
    </button>

    <button type="button" role="switch"
            aria-checked="<%= enabled?(email_field) %>"
            data-action="click->settings--field-component#toggle"
            data-field-value="<%= email_field %>"
            class="group flex w-6 h-4 p-1 rounded-full bg-gray-400 transition-colors duration-200 ease-in-out overflow-hidden outline-none focus-visible:ring focus-visible:ring-teal-400 aria-checked:bg-teal-400">
      <span class="w-2 h-2 rounded-full bg-white transition-transform duration-200 ease-in-out group-aria-checked:translate-x-full"></span>
    </button>

    <button type="button" role="switch"
            aria-checked="<%= enabled?(push_field) %>"
            data-action="click->settings--field-component#toggle"
            data-field-value="<%= push_field %>"
            class="group flex w-6 h-4 p-1 rounded-full bg-gray-400 transition-colors duration-200 ease-in-out overflow-hidden outline-none focus-visible:ring focus-visible:ring-teal-400 aria-checked:bg-teal-400">
      <span class="w-2 h-2 rounded-full bg-white transition-transform duration-200 ease-in-out group-aria-checked:translate-x-full"></span>
    </button>
  </div>
</div>
