# ====================================================================
# 1. ПАПКИ STORAGE И TMP (Закрываем всё, кроме самих логов для изучения)
# ====================================================================
storage/**/*
tmp/**/*

# Разрешаем ИИ читать файлы логов (.log), если они лежат внутри tmp или storage
!tmp/**/*.log
!storage/**/*.log

# ====================================================================
# 2. VENDOR (Гемы) И NODE_MODULES (Пакеты)
# ====================================================================
# Игнорируем всё содержимое этих папок по умолчанию
vendor/**/*
node_modules/**/*

# --- ИСКЛЮЧЕНИЯ: Разрешаем читать документацию ---
!vendor/**/README*
!vendor/**/*.md
!vendor/**/*.txt
!vendor/**/docs/
!node_modules/**/README*
!node_modules/**/*.md
!node_modules/**/docs/

# --- ИСКЛЮЧЕНИЯ: Разрешаем читать исходный код библиотек ---
# Для Ruby/Rails гемов в vendor
!vendor/**/*.rb
!vendor/**/Gemfile
!vendor/**/*.gemspec

# Для Node.js пакетов во фронтенде
!node_modules/**/*.js
!node_modules/**/*.ts
!node_modules/**/package.json

# --- ИСКЛЮЧЕНИЯ: Если есть папки тестов или спецификаций в библиотеках ---
!vendor/**/spec/
!vendor/**/test/
!node_modules/**/test/
