<div class="p-4">
  <button type="button"
          onclick="document.getElementById('demo-dialog-danger').classList.remove('hidden')"
          class="px-4 py-2 bg-red-600 text-white rounded-lg text-sm font-medium hover:bg-red-700 cursor-pointer">
    Удалить объект (Да / Нет)
  </button>

  <%= render Ui::ConfirmDialogComponent.new(
        dialog_id: "demo-dialog-danger",
        title: "Удаление аккаунта",
        message: "Это действие необратимо. Все ваши данные будут безвозвратно удалены.",
        confirm_text: "Да",
        cancel_text: "Нет",
        confirm_variant: :danger,
        confirm_url: "#",
        confirm_method: :delete
      ) %>
</div>
