<div class="p-20 bg-secondary flex items-center justify-center">
  <%= render Ui::TooltipComponent.new(position: :bottom) do |t| %>
    <% t.with_trigger_element do %>
      <div class="flex items-center gap-2 px-4 py-2 bg-primary text-primary rounded-xl text-xs font-semibold shadow-md hover:bg-secondary transition">
        <span class="mdi mdi-card-text-outline text-base"></span>
        <span>Наведи для просмотра карточки</span>
      </div>
    <% end %>

    <% t.with_popover do %>
      <div class="w-72">
        <%= render Ui::CardComponent.new do %>
          <div class="p-4 space-y-2">
            <div class="flex items-center justify-between">
              <h4 class="font-bold text-sm text-primary">Ui::CardComponent</h4>
              <span class="px-2 py-0.5 text-[10px] font-semibold bg-success/10 text-success rounded-full">
                Live Preview
              </span>
            </div>
            <p class="text-xs text-secondary leading-relaxed">
              Карточка отрендерена через <code class="bg-secondary px-1 py-0.5 rounded text-accent">Ui::CardComponent</code> внутри слота <code class="bg-secondary px-1 py-0.5 rounded text-accent">popover</code>.
            </p>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
