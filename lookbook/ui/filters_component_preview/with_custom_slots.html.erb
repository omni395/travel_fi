<div class="p-8 bg-gray-50 rounded-xl">
  <%= render Ui::FiltersComponent.new(reset_action: "dummy#reset") do |f| %>
    <%# Кастомный поиск 1 %>
    <% f.with_search do %>
      <div class="relative min-w-40">
        <input type="text" placeholder="ID заказа..." class="block w-full min-w-0 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm leading-5 text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 disabled:cursor-not-allowed disabled:bg-gray-100 disabled:text-gray-500 text-sm">
      </div>
    <% end %>

    <%# Кастомный фильтр 2 (Выбор даты) %>
    <% f.with_filter do %>
      <input type="date" class="block w-full min-w-0 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm leading-5 text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 disabled:cursor-not-allowed disabled:bg-gray-100 disabled:text-gray-500 text-sm">
    <% end %>

    <%# Кастомная кнопка экспорта %>
    <% f.with_extra_actions do %>
      <%= render Ui::BtnComponent.new(color: :secondary, size: :md) do %>
        <i class="mdi mdi-download text-lg"></i>
        <span>Экспорт</span>
      <% end %>
    <% end %>
  <% end %>
</div>
