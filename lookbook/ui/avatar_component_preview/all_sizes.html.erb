<div class="flex items-end gap-6 p-6 bg-slate-50 rounded-xl border border-slate-200">
  <% %i[sm md lg xl].each do |size| %>
    <div class="flex flex-col items-center gap-2">
      <%= render Ui::AvatarComponent.new(user: Ui::AvatarComponentPreview::MockUser.new(name: "Alex", avatar_url: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150"), size: size) %>
      <span class="text-xs font-mono text-slate-400"><%= size %></span>
    </div>
  <% end %>

  <div class="h-12 w-px bg-slate-200 mx-2"></div>

  <% %i[sm md lg xl].each do |size| %>
    <div class="flex flex-col items-center gap-2">
      <%= render Ui::AvatarComponent.new(user: Ui::AvatarComponentPreview::MockUser.new(name: "Борис", avatar_url: nil), size: size) %>
      <span class="text-xs font-mono text-slate-400"><%= size %> (initials)</span>
    </div>
  <% end %>
</div>
