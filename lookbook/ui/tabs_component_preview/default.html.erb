<div class="p-8 max-w-2xl bg-secondary/10 rounded-xl">
  <%= render Ui::TabsComponent.new(
        tabs: [
          { id: "activity",  name: "Активность", icon: "mdi-history" },
          { id: "wallet",    name: "Кошелек",    icon: "mdi-wallet" },
          { id: "card_tab",  name: "Карточка",   icon: "mdi-card-account-details-outline" },
          { id: "empty_tab", name: "Пусто",      icon: "mdi-file-outline" }
        ],
        active_tab: "activity",
        panels: {
          activity: "<p class='p-2'>История последних действий пользователя...</p>".html_safe,
          wallet: "<p class='p-2'>Текущий баланс: <strong>1,250 EUR</strong></p>".html_safe,
          card_tab: render(Ui::CardComponent.new) { |c|
            c.with_header do
              "<h3 class='text-lg font-bold text-primary'>Профиль пользователя</h3>".html_safe
            end
            c.with_body do
              "<p class='text-secondary'>Содержимое профиля с важной информацией, выведенное через слот <code>body</code> компонента <code>Ui::CardComponent</code>.</p>".html_safe
            end
            c.with_footer do
              render(Ui::BtnComponent.new(color: :primary, size: :sm)) { "Сохранить" }
            end
          }
        }
      ) %>
</div>
