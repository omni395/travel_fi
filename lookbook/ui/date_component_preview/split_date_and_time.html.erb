<div class="p-4 space-y-3 bg-white rounded-xl border border-gray-100 shadow-sm">
  <div class="flex items-center gap-4">
    <span class="w-40 text-xs font-semibold text-gray-500">Только дата (:date_only):</span>
    <%= render Ui::DateComponent.new(sample_time, format: :date_only) %>
  </div>

  <div class="flex items-center gap-4">
    <span class="w-40 text-xs font-semibold text-gray-500">Только время (:time_only):</span>
    <%= render Ui::DateComponent.new(sample_time, format: :time_only) %>
  </div>

  <div class="flex items-center gap-4">
    <span class="w-40 text-xs font-semibold text-gray-500">Относительное (:relative):</span>
    <%= render Ui::DateComponent.new(sample_time, format: :relative) %>
  </div>
</div>
