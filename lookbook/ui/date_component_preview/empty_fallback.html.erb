<div class="p-4 space-y-3 bg-white rounded-xl border border-gray-100 shadow-sm">
  <div class="flex items-center gap-4">
    <span class="w-44 text-xs font-semibold text-gray-500">Nil (Перевод по умолчанию):</span>
    <%= render Ui::DateComponent.new(nil) %>
  </div>

  <div class="flex items-center gap-4">
    <span class="w-44 text-xs font-semibold text-gray-500">Nil (Кастомный fallback):</span>
    <%= render Ui::DateComponent.new(nil, fallback: "Дата не указана") %>
  </div>
</div>
