<div class="p-4 space-y-3 bg-white rounded-xl border border-gray-100 shadow-sm">
  <div class="flex items-center gap-4">
    <span class="w-32 text-xs font-semibold text-gray-500">Короткий (:short):</span>
    <%= render Ui::DateComponent.new(sample_time, format: :short) %>
  </div>

  <div class="flex items-center gap-4">
    <span class="w-32 text-xs font-semibold text-gray-500">Длинный (:long):</span>
    <%= render Ui::DateComponent.new(sample_time, format: :long) %>
  </div>

  <div class="flex items-center gap-4">
    <span class="w-32 text-xs font-semibold text-gray-500">Дефолтный (:default):</span>
    <%= render Ui::DateComponent.new(sample_time, format: :default) %>
  </div>
</div>
